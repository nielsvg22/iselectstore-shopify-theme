<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#1f3049">
  <title>{{ shop.name | escape }}</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% render 'brand-head' %}
  <link rel="icon" href="{{ 'brand-mark-coral.svg' | asset_url }}" type="image/svg+xml">
  {{ content_for_header }}
</head>
<body class="passwordPage"><main>{{ content_for_layout }}</main></body>
</html>
