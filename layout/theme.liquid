<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#1f3049">
<title>{% if page_title == blank or page_title == shop.name or request.page_type == 'index' %}iSelectStore{% else %}{{ page_title | escape }}{% unless page_title contains 'iSelectStore' %} &ndash; iSelectStore{% endunless %}{% endif %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'animations.css' | asset_url | stylesheet_tag }}
{% render 'brand-head' %}
{{ 'desktop-atmosphere.css' | asset_url | stylesheet_tag }}
<style>
  :root{
    --navy: {{ settings.color_navy | default: "#1f3049" }};
    --coral: {{ settings.color_coral | default: "#f9858b" }};
    --ivory: {{ settings.color_ivory | default: "#f7f7f7" }};
    --lightblue: {{ settings.color_lightblue | default: "#e4ecf4" }};
    --lightpink: {{ settings.color_lightcoral | default: "#ffe6ed" }};
    --anthracite: {{ settings.color_anthracite | default: "#25292d" }};
    --soft: {{ settings.color_ivory | default: "#f7f7f7" }};
  }
</style>
{% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">{% else %}<link rel="icon" href="{{ 'brand-mark-coral.svg' | asset_url }}" type="image/svg+xml">{% endif %}
<noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
{% comment %}
  GEO/SEO: Organization structured data op elke pagina, zodat
  zoekmachines en AI-antwoordmachines iSelectStore als entiteit herkennen
  (naam, logo, contactkanaal, social profielen).
{% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "iSelectStore",
  "url": {{ shop.url | json }},
  "logo": {{ 'brand-logo-primary.svg' | asset_url | prepend: "https:" | json }}
  {%- assign same_as = "" | split: "," -%}
  {%- if settings.social_instagram_link != blank -%}{%- assign same_as = same_as | push: settings.social_instagram_link -%}{%- endif -%}
  {%- if settings.social_facebook_link != blank -%}{%- assign same_as = same_as | push: settings.social_facebook_link -%}{%- endif -%}
  {%- if same_as.size > 0 -%}, "sameAs": {{ same_as | json }}{%- endif -%}
  {%- if settings.whatsapp_number != blank -%}, "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "telephone": "+{{ settings.whatsapp_number }}" }{%- endif -%}
}
</script>
{{ content_for_header }}
</head>
<body data-store-page="{{ request.page_type | escape }}">
{% section 'header' %}

<main>
  {{ content_for_layout }}
</main>

{% section 'language-selector' %}
{% section 'footer' %}

{% render 'whatsapp-float' %}

<script>
  window.themeStrings = {
    locale: {{ request.locale.iso_code | json }},
    strings: {
      tradeIn: {
        step_of: {{ 'trade_in.modal.step_of' | t | json }},
        choose_model: {{ 'trade_in.modal.choose_model' | t | json }},
        storage_question: {{ 'trade_in.modal.storage_question' | t | json }},
        storage_other: {{ 'trade_in.modal.storage_other' | t | json }},
        color_question: {{ 'trade_in.modal.color_question' | t | json }},
        color_placeholder: {{ 'trade_in.modal.color_placeholder' | t | json }},
        battery_exact_question: {{ 'trade_in.modal.battery_exact_question' | t | json }},
        battery_exact_placeholder: {{ 'trade_in.modal.battery_exact_placeholder' | t | json }},
        cycles_question: {{ 'trade_in.modal.cycles_question' | t | json }},
        cycles_placeholder: {{ 'trade_in.modal.cycles_placeholder' | t | json }},
        cycles_unknown: {{ 'trade_in.modal.cycles_unknown' | t | json }},
        parts_question: {{ 'trade_in.modal.parts_question' | t | json }},
        sim_question: {{ 'trade_in.modal.sim_question' | t | json }},
        screen_question: {{ 'trade_in.modal.screen_question' | t | json }},
        yes: {{ 'trade_in.modal.yes' | t | json }},
        no: {{ 'trade_in.modal.no' | t | json }},
        scratches_question: {{ 'trade_in.modal.scratches_question' | t | json }},
        scratches_light: {{ 'trade_in.modal.scratches_light' | t | json }},
        scratches_heavy: {{ 'trade_in.modal.scratches_heavy' | t | json }},
        scratches_broken: {{ 'trade_in.modal.scratches_broken' | t | json }},
        damage_question: {{ 'trade_in.modal.damage_question' | t | json }},
        damage_placeholder: {{ 'trade_in.modal.damage_placeholder' | t | json }},
        continue_label: {{ 'trade_in.modal.continue' | t | json }},
        skip: {{ 'trade_in.modal.skip' | t | json }},
        accessories_question: {{ 'trade_in.modal.accessories_question' | t | json }},
        accessories_yes: {{ 'trade_in.modal.accessories_yes' | t | json }},
        accessories_partial: {{ 'trade_in.modal.accessories_partial' | t | json }},
        accessories_no: {{ 'trade_in.modal.accessories_no' | t | json }},
        icloud_question: {{ 'trade_in.modal.icloud_question' | t | json }},
        icloud_yes: {{ 'trade_in.modal.icloud_yes' | t | json }},
        icloud_no: {{ 'trade_in.modal.icloud_no' | t | json }},
        icloud_unsure: {{ 'trade_in.modal.icloud_unsure' | t | json }},
        back: {{ 'trade_in.modal.back' | t | json }},
        restart: {{ 'trade_in.modal.restart' | t | json }},
        estimated: {{ 'trade_in.modal.estimated' | t | json }},
        summary_model: {{ 'trade_in.modal.summary_model' | t | json }},
        summary_storage: {{ 'trade_in.modal.summary_storage' | t | json }},
        summary_color: {{ 'trade_in.modal.summary_color' | t | json }},
        summary_battery: {{ 'trade_in.modal.summary_battery' | t | json }},
        summary_cycles: {{ 'trade_in.modal.summary_cycles' | t | json }},
        summary_parts: {{ 'trade_in.modal.summary_parts' | t | json }},
        summary_sim: {{ 'trade_in.modal.summary_sim' | t | json }},
        summary_screen: {{ 'trade_in.modal.summary_screen' | t | json }},
        summary_accessories: {{ 'trade_in.modal.summary_accessories' | t | json }},
        summary_icloud: {{ 'trade_in.modal.summary_icloud' | t | json }},
        note: {{ 'trade_in.modal.note' | t | json }},
        whatsapp_cta: {{ 'trade_in.modal.whatsapp_cta' | t | json }},
        whatsapp_message: {{ 'trade_in.modal.whatsapp_message' | t | json }},
        whatsapp_damage_line: {{ 'trade_in.modal.whatsapp_damage_line' | t | json }},
        whatsapp_number: {{ settings.whatsapp_number | json }},
        close_aria: {{ 'trade_in.modal.close_aria' | t | json }}
      },
      tradeInModels: {
        ipad: {{ 'trade_in.models.ipad' | t | json }},
        macbook: {{ 'trade_in.models.macbook' | t | json }},
        watch: {{ 'trade_in.models.watch' | t | json }}
      }
    },
    inventoryErrors: {
      generic: {{ 'inventory_notify.errors.generic' | t | json }},
      invalid_email: {{ 'inventory_notify.errors.invalid_email' | t | json }},
      invalid_product: {{ 'inventory_notify.errors.invalid_product' | t | json }},
      unrecognized_product: {{ 'inventory_notify.errors.unrecognized_product' | t | json }},
      already_subscribed: {{ 'inventory_notify.errors.already_subscribed' | t | json }},
      rate_limited: {{ 'inventory_notify.errors.rate_limited' | t | json }}
    }
  };
</script>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
