{% assign heading_default = 'authenticity_compare.heading_default' | t %}
{% assign sub_default = 'authenticity_compare.sub_default' | t %}
{% assign info_label_default = 'authenticity_compare.info_label' | t %}
{% assign legend_good_title_default = 'authenticity_compare.legend_good_title' | t %}
{% assign legend_good_sub_default = 'authenticity_compare.legend_good_sub' | t %}
{% assign legend_bad_title_default = 'authenticity_compare.legend_bad_title' | t %}
{% assign legend_bad_sub_default = 'authenticity_compare.legend_bad_sub' | t %}

<section class="stSection" id="authenticity-compare"><div class="wrap" style="max-width:720px">
  <div class="authCompareHead reveal">
    <h2>{{ section.settings.heading | default: heading_default }}</h2>
    <a class="authInfoPill" href="{{ section.settings.info_link | default: '#story-intro' }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="11" x2="12" y2="16"></line><circle cx="12" cy="8" r="0.5" fill="currentColor"></circle></svg>
      {{ section.settings.info_label | default: info_label_default }}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>
    </a>
  </div>
  <p class="sub authCompareSub reveal">{{ section.settings.subtext | default: sub_default }}</p>

  <div class="authLegend reveal">
    <div class="authLegendTile authLegendTile--good">
      <span class="authLegendIcon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 2c.3 1.4-.2 2.8-1.1 3.8-.9 1-2.2 1.7-3.5 1.6-.3-1.4.2-2.9 1.1-3.8C13.9 2.6 15.2 2 16.5 2zM20.5 16.7c-.5 1.2-.8 1.7-1.4 2.7-.9 1.4-2.2 3.1-3.8 3.1-1.4 0-1.8-.9-3.7-.9s-2.4.9-3.7.9c-1.6 0-2.8-1.6-3.7-2.9C2.3 17.1 1.7 13.3 3 10.6c.9-1.9 2.5-3.1 4.3-3.1 1.5 0 2.5 1 3.7 1 1.2 0 2-1 3.7-1 1.4 0 2.9.8 3.9 2.1-3.5 2-2.9 6.9 2 7.1z"/></svg></span>
      <div><b>{{ legend_good_title_default }}</b><span>{{ legend_good_sub_default }}</span></div>
    </div>
    <div class="authLegendTile authLegendTile--bad">
      <span class="authLegendIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></span>
      <div><b>{{ legend_bad_title_default }}</b><span>{{ legend_bad_sub_default }}</span></div>
    </div>
  </div>

  <div class="authRows">
    {% for block in section.blocks %}
      {% assign row_label_key = 'authenticity_compare.rows.' | append: forloop.index | append: '.label' %}
      {% assign row_desc_key = 'authenticity_compare.rows.' | append: forloop.index | append: '.description' %}
      {% assign row_good_key = 'authenticity_compare.rows.' | append: forloop.index | append: '.good' %}
      {% assign row_bad_key = 'authenticity_compare.rows.' | append: forloop.index | append: '.bad' %}
      {% assign row_label_default = row_label_key | t %}
      {% assign row_desc_default = row_desc_key | t %}
      {% assign row_good_default = row_good_key | t %}
      {% assign row_bad_default = row_bad_key | t %}
      {% if row_label_default contains 'translation missing' %}{% assign row_label_default = '' %}{% endif %}
      {% if row_desc_default contains 'translation missing' %}{% assign row_desc_default = '' %}{% endif %}
      {% if row_good_default contains 'translation missing' %}{% assign row_good_default = '' %}{% endif %}
      {% if row_bad_default contains 'translation missing' %}{% assign row_bad_default = '' %}{% endif %}
      <div class="authRowCard reveal" style="transition-delay:{{ forloop.index0 | times: 0.05 | round: 2 }}s" {{ block.shopify_attributes }}>
        <div class="authRowHead">
          <span class="authRowIcon" aria-hidden="true">
            {% if block.settings.icon != blank %}
              {{ block.settings.icon }}
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle></svg>
            {% endif %}
          </span>
          <div>
            <b>{{ block.settings.label | default: row_label_default }}</b>
            <span>{{ block.settings.description | default: row_desc_default }}</span>
          </div>
        </div>
        <div class="authRowOption authRowOption--good">
          <span class="authRowRadio"></span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="authCheckIcon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>{{ block.settings.good_text | default: row_good_default }}</span>
        </div>
        <div class="authRowOption">
          <span class="authRowRadio"></span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="authCrossIcon" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          <span>{{ block.settings.bad_text | default: row_bad_default }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</div></section>

{% schema %}
{
  "name": "Vergelijking origineel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "subtext", "label": "Introregel" },
    { "type": "text", "id": "info_label", "label": "Info-knop tekst" },
    { "type": "url", "id": "info_link", "label": "Info-knop link" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Vergelijkingsregel",
      "settings": [
        { "type": "html", "id": "icon", "label": "Icoon (SVG, optioneel)" },
        { "type": "text", "id": "label", "label": "Label (bv. Batterij)" },
        { "type": "text", "id": "description", "label": "Korte omschrijving" },
        { "type": "text", "id": "good_text", "label": "Origineel — tekst" },
        { "type": "text", "id": "bad_text", "label": "Aftermarket — tekst" }
      ]
    }
  ],
  "presets": [{ "name": "Vergelijking origineel" }]
}
{% endschema %}
