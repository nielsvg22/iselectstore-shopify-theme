{% assign eyebrow_default = 'authenticity_compare.eyebrow' | t %}
{% assign heading_default = 'authenticity_compare.heading_default' | t %}
{% assign sub_default = 'authenticity_compare.sub_default' | t %}
{% assign original_label = 'authenticity_compare.original_label' | t %}
{% assign aftermarket_label = 'authenticity_compare.aftermarket_label' | t %}

<section class="stSection" id="authenticity-compare"><div class="wrap">
  <div class="head reveal">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow | default: eyebrow_default }}</p>
      <h2>{{ section.settings.heading | default: heading_default }}</h2>
      <p class="sub" style="max-width:640px">{{ section.settings.subtext | default: sub_default }}</p>
    </div>
  </div>

  <div class="authCompare reveal">
    <table class="authCompareTable">
      <thead>
        <tr>
          <th class="authCompareRowLabel"></th>
          <th class="authCompareCol authCompareCol--good">{{ original_label }}</th>
          <th class="authCompareCol">{{ aftermarket_label }}</th>
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          {% assign row_label_key = 'authenticity_compare.rows.' | append: forloop.index | append: '.label' %}
          {% assign row_good_key = 'authenticity_compare.rows.' | append: forloop.index | append: '.good' %}
          {% assign row_bad_key = 'authenticity_compare.rows.' | append: forloop.index | append: '.bad' %}
          {% assign row_label_default = row_label_key | t %}
          {% assign row_good_default = row_good_key | t %}
          {% assign row_bad_default = row_bad_key | t %}
          {% if row_label_default contains 'translation missing' %}{% assign row_label_default = '' %}{% endif %}
          {% if row_good_default contains 'translation missing' %}{% assign row_good_default = '' %}{% endif %}
          {% if row_bad_default contains 'translation missing' %}{% assign row_bad_default = '' %}{% endif %}
          <tr {{ block.shopify_attributes }}>
            <td class="authCompareRowLabel">
              <span class="authCompareIcon" aria-hidden="true">
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon }}
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle></svg>
                {% endif %}
              </span>
              {{ block.settings.label | default: row_label_default }}
            </td>
            <td class="authCompareCol authCompareCol--good">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="authCheckIcon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>{{ block.settings.good_text | default: row_good_default }}</span>
            </td>
            <td class="authCompareCol">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="authCrossIcon" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              <span>{{ block.settings.bad_text | default: row_bad_default }}</span>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div></section>

{% schema %}
{
  "name": "Vergelijking origineel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "subtext", "label": "Introregel" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Vergelijkingsregel",
      "settings": [
        { "type": "html", "id": "icon", "label": "Icoon (SVG, optioneel)" },
        { "type": "text", "id": "label", "label": "Label (bv. Batterij)" },
        { "type": "text", "id": "good_text", "label": "Origineel — tekst" },
        { "type": "text", "id": "bad_text", "label": "Aftermarket — tekst" }
      ]
    }
  ],
  "presets": [{ "name": "Vergelijking origineel" }]
}
{% endschema %}
