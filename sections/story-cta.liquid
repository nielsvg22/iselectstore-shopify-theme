{% assign eyebrow_default = 'story_page.cta.eyebrow' | t %}
{% assign heading_default = 'story_page.cta.heading_default' | t %}
{% assign text_default = 'story_page.cta.text_default' | t %}
{% assign button_default = 'story_page.cta.button_default' | t %}

<section class="stSection stCtaSection"><div class="wrap">
  <div class="stCtaCard reveal">
    <span class="stCtaMark" aria-hidden="true">
      <svg class="mark" viewBox="0 0 24 24"><path d="M12 0c.9 3.2 2 5.6 3.4 7.1C16.9 8.6 19.2 9.7 22.4 10.6c-3.2.9-5.5 2-7 3.5C13.9 15.6 12.8 18 12 21.1c-.8-3.1-1.9-5.5-3.4-7C7.1 12.6 4.8 11.5 1.6 10.6c3.2-.9 5.5-2 7-3.5C10.1 5.6 11.2 3.2 12 0z"/></svg>
    </span>
    <p class="eyebrow">{{ section.settings.eyebrow | default: eyebrow_default }}</p>
    <h2>{{ section.settings.heading | default: heading_default }}</h2>
    <p class="sub">{{ section.settings.text | default: text_default }}</p>
    {% if section.settings.show_button != false %}
      <a class="btn primary stCtaBtn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label | default: button_default }}
      </a>
    {% endif %}
  </div>
</div></section>

{% schema %}
{
  "name": "Verhaal-afsluiting",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "button_label", "label": "Knop-tekst" },
    { "type": "url", "id": "button_link", "label": "Knop-link" },
    { "type": "checkbox", "id": "show_button", "label": "Toon knop", "default": true }
  ]
}
{% endschema %}
