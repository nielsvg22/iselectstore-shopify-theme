<section class="shopHero"><div class="wrap">
  <div class="breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.breadcrumb_home' | t }}</a><span>/</span><span style="color:#fff">{{ 'header.nav.contact' | t }}</span></div>
  <p class="eyebrow">{{ 'contact.eyebrow' | t }}</p>
  <h1>{{ 'contact.heading' | t }}</h1>
  <p>{{ 'contact.intro' | t }}</p>
</div></section>

<section><div class="wrap reveal">
  <div class="cartLayout">
    <div>
      {% form 'contact', id: 'contactForm' %}
        {% if form.posted_successfully? %}
          <div class="orderDone" style="padding:30px 0">
            <div class="checkIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg></div>
            <h2 style="font-size:22px">{{ 'contact.success_title' | t }}</h2>
            <p>{{ 'contact.success_text' | t }}</p>
          </div>
        {% else %}
          {% if form.errors %}
            <div class="checkoutBlock" role="alert" style="border-color:var(--coral-ink)">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <div class="checkoutBlock">
            <h3>{{ 'contact.your_details' | t }}</h3>
            <div class="formGrid">
              <input type="text" name="contact[name]" placeholder="{{ 'contact.name_placeholder' | t }}" required>
              <input type="email" name="contact[email]" placeholder="{{ 'contact.email_placeholder' | t }}" required value="{{ form.email }}">
            </div>
          </div>
          <div class="checkoutBlock">
            <h3>{{ 'contact.subject' | t }}</h3>
            <div class="formRow"><input type="text" name="contact[subject]" placeholder="{{ 'contact.subject_placeholder' | t }}"></div>
          </div>
          <div class="checkoutBlock">
            <h3>{{ 'contact.message' | t }}</h3>
            <div class="formRow"><textarea name="contact[body]" rows="6" placeholder="{{ 'contact.message_placeholder' | t }}" required style="width:100%;padding:13px 16px;border:1.5px solid var(--line);border-radius:14px;font-family:inherit;font-size:14px;resize:vertical"></textarea></div>
          </div>
          <button class="add" type="submit" style="width:100%;height:52px;font-size:15px">{{ 'contact.submit' | t }}</button>
        {% endif %}
      {% endform %}
    </div>

    <aside class="cartSummary">
      <h3>{{ 'contact.direct_contact' | t }}</h3>
      {% if section.settings.whatsapp %}<a href="https://wa.me/{{ section.settings.whatsapp }}" target="_blank" rel="noopener" class="btn primary" style="width:100%;justify-content:center;margin-bottom:14px">{{ 'contact.whatsapp' | t }}</a>{% endif %}
      {% if section.settings.phone %}<div class="sumRow"><span>{{ 'contact.phone' | t }}</span><b>{{ section.settings.phone }}</b></div>{% endif %}
      <div class="sumRow"><span>{{ 'contact.email' | t }}</span><b>{{ shop.email }}</b></div>
      {% if section.settings.address %}<div class="sumRow" style="margin-bottom:0"><span>{{ 'contact.address' | t }}</span><b style="text-align:right">{{ section.settings.address }}</b></div>{% endif %}
      <p style="color:var(--muted);font-size:12.5px;margin-top:16px">{{ 'contact.visit_note' | t }}</p>
    </aside>
  </div>
</div></section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "whatsapp", "label": "WhatsApp nummer (bv. 31643295022)" },
    { "type": "text", "id": "phone", "label": "Telefoonnummer" },
    { "type": "text", "id": "address", "label": "Adres" }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
