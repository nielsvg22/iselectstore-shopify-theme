{% assign eyebrow_default = 'story_page.values.eyebrow' | t %}
{% assign heading_default = 'story_page.values.heading_default' | t %}
{% assign sub_default = 'story_page.values.sub_default' | t %}

<section class="stSection stSoft" id="story-values"><div class="wrap">
  <div class="head reveal">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow | default: eyebrow_default }}</p>
      <h2>{{ section.settings.heading | default: heading_default }}</h2>
      <p class="sub" style="max-width:640px">{{ section.settings.subtext | default: sub_default }}</p>
    </div>
  </div>

  <div class="stValues">
    {% for block in section.blocks %}
      {% assign title_key = 'story_page.values.items.' | append: forloop.index | append: '.title' %}
      {% assign text_key = 'story_page.values.items.' | append: forloop.index | append: '.text' %}
      {% assign title_default = title_key | t %}
      {% assign text_default = text_key | t %}
      {% if title_default contains 'translation missing' %}{% assign title_default = '' %}{% endif %}
      {% if text_default contains 'translation missing' %}{% assign text_default = '' %}{% endif %}
      <article class="stValueCard reveal" style="transition-delay:{{ forloop.index0 | times: 0.07 | round: 2 }}s" {{ block.shopify_attributes }}>
        <div class="bubble stValueIcon">
          {% if block.settings.icon != blank %}
            {{ block.settings.icon }}
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 5-5"></path></svg>
          {% endif %}
        </div>
        <h3>{{ block.settings.title | default: title_default }}</h3>
        <p>{{ block.settings.text | default: text_default }}</p>
      </article>
    {% endfor %}
  </div>
</div></section>

{% schema %}
{
  "name": "Verhaal-waarden",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "subtext", "label": "Introregel" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Waarde",
      "settings": [
        { "type": "html", "id": "icon", "label": "Icoon (SVG)" },
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "textarea", "id": "text", "label": "Tekst" }
      ]
    }
  ],
  "presets": [{ "name": "Verhaal-waarden" }]
}
{% endschema %}
