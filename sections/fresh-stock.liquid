{% comment %}
  "Vers in voorraad": compacte lijst van de laatst toegevoegde toestellen,
  licht kaartontwerp — geeft het gevoel dat er voortdurend nieuwe, unieke
  exemplaren bijkomen.
{% endcomment %}
{% assign eyebrow_default = 'fresh_stock.eyebrow' | t %}
{% assign heading_default = 'fresh_stock.heading' | t %}
{% assign subtext_default = 'fresh_stock.subtext' | t %}
{% assign view_all_default = 'fresh_stock.view_all' | t %}
{% assign unique_default = 'fresh_stock.unique' | t %}
{% assign button_default = 'fresh_stock.button' | t %}

{% assign stock_collection = section.settings.collection %}
{% assign stock_count = section.settings.count | default: 3 %}

{% if stock_collection %}
  {% assign products = stock_collection.products | where: 'available', true | reject: 'type', 'Accessoire' | sort: 'created_at' | reverse %}

  {% if products.size > 0 %}
  <section class="freshStock reveal"><div class="wrap">
    <div class="freshStockHead">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow | default: eyebrow_default }}</p>
        <h2>{{ section.settings.heading | default: heading_default }}</h2>
        <p class="freshStockSub">{{ section.settings.subtext | default: subtext_default }}</p>
      </div>
      <a class="freshStockViewAll" href="{{ stock_collection.url }}">{{ section.settings.view_all_text | default: view_all_default }}</a>
    </div>

    <div class="freshStockList">
      {% assign shown = 0 %}
      {% for product in products %}
        {% unless product.available %}{% continue %}{% endunless %}
        {% if shown >= stock_count %}{% break %}{% endif %}
        <div class="freshStockRow">
          <a class="freshStockLike" href="#" aria-label="{{ 'fresh_stock.like_aria' | t }}" data-fresh-like>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path></svg>
          </a>
          <a class="freshStockLink" href="{{ product.url }}">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 140 }}" width="70" height="70" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
            {% endif %}
            <div class="freshStockInfo">
              <h3>{{ product.title }}</h3>
              <b>{{ product.price | money }}</b>
              <span class="freshStockTag">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 12.3L12.7 20.2a2 2 0 0 1-2.8 0l-6.1-6.1a2 2 0 0 1 0-2.8L11.7 3.3a2 2 0 0 1 1.4-.6H19a2 2 0 0 1 2 2v6.3a2 2 0 0 1-.4 1.3z"></path><circle cx="15.5" cy="7.5" r="1.2" fill="currentColor" stroke="none"></circle></svg>
                {{ section.settings.unique_label | default: unique_default }}
              </span>
            </div>
            <span class="freshStockArrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </span>
          </a>
        </div>
        {% assign shown = shown | plus: 1 %}
      {% endfor %}
    </div>

    <a class="btn primary freshStockBtn" href="{{ stock_collection.url }}">{{ section.settings.button_text | default: button_default }}</a>
  </div></section>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Vers in voorraad",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collectie" },
    { "type": "range", "id": "count", "label": "Aantal toestellen", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "eyebrow", "label": "Kicker-tekst" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "text", "id": "subtext", "label": "Subtekst" },
    { "type": "text", "id": "view_all_text", "label": "'Bekijk alles'-tekst" },
    { "type": "text", "id": "unique_label", "label": "Label per toestel" },
    { "type": "text", "id": "button_text", "label": "Knoptekst" }
  ],
  "presets": [{ "name": "Vers in voorraad" }]
}
{% endschema %}
