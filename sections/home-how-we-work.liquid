{% comment %}
  "Zie hoe wij werken" — homepage-sectie met de bedrijfsvideo. Speelt
  automatisch af zodra de pagina laadt (gemuted — browsers staan autoplay
  met geluid nooit toe), met een knop om geluid aan te zetten. Bewust
  gekozen door de klant, ook al laadt het videobestand hierdoor altijd mee
  met de pagina (in tegenstelling tot de klik-om-te-laden video-miniatuur
  in de productgalerij, sections/main-product.liquid, die wel lazy blijft).
{% endcomment %}

{% if section.settings.video %}
  {% assign poster_url = section.settings.video_poster | default: section.settings.video.preview_image %}
  <section class="stSection stHowWeWorkSection"><div class="wrap">
    <div class="stHowWeWork reveal">
      <div class="stHowWeWorkMedia">
        <video id="howWeWorkVideo" autoplay muted loop playsinline preload="auto" poster="{{ poster_url | image_url: width: 900 }}">
          <source src="{{ section.settings.video.sources.last.url }}" type="video/mp4">
        </video>
        <button type="button" class="stHowWeWorkSound" id="howWeWorkSound" aria-label="{{ 'home_how_we_work.sound_on_aria' | t }}" aria-pressed="false">
          <svg class="iconMuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
          <svg class="iconSound" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5.5a9 9 0 0 1 0 13"/></svg>
        </button>
      </div>
      <div class="stHowWeWorkCopy">
        <span class="stHomeCtaMark" aria-hidden="true">{% render 'icon-mark', size: 26 %}</span>
        <p class="eyebrow">{{ section.settings.eyebrow | default: 'home_how_we_work.eyebrow' | t }}</p>
        <h2>{{ section.settings.heading | default: 'home_how_we_work.heading' | t }}</h2>
        <p class="sub">{{ section.settings.text | default: 'home_how_we_work.text' | t }}</p>
        {% if section.settings.show_rating %}
          {% assign reviews_word = 'footer.badges.reviews_count_suffix' | t %}
          {% assign dyn_rating_full = shop.metafields.custom.rating_average | append: '/10 · ' | append: shop.metafields.custom.review_count | append: ' WebwinkelKeur-' | append: reviews_word %}
          <div class="stHowWeWorkRating">
            <span class="stars" aria-hidden="true">★★★★★</span>
            <span>{% if section.settings.rating_text != blank %}{{ section.settings.rating_text }}{% elsif shop.metafields.custom.rating_average != blank %}{{ dyn_rating_full }}{% else %}{{ 'home_how_we_work.rating_default' | t }}{% endif %}</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div></section>
{% endif %}

{% schema %}
{
  "name": "Homepage — Hoe wij werken",
  "settings": [
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "image_picker", "id": "video_poster", "label": "Voorbeeldafbeelding (poster)", "info": "Leeg gebruikt de preview-afbeelding van de video zelf." },
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "text", "label": "Tekst" },
    { "type": "checkbox", "id": "show_rating", "label": "WebwinkelKeur-waardering tonen", "default": true },
    { "type": "text", "id": "rating_text", "label": "Waarderingstekst" }
  ],
  "presets": [{ "name": "Homepage — Hoe wij werken" }]
}
{% endschema %}
