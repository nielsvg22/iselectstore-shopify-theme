<section class="shopHero"><div class="wrap">
  <div class="breadcrumb"><a href="{{ routes.root_url }}">{{ 'product_page.breadcrumb_home' | t }}</a><span>/</span><span style="color:#fff">{{ 'search_page.breadcrumb' | t }}</span></div>
  <p class="eyebrow">{{ 'search_page.eyebrow' | t }}</p>
  <h1>"{{ search.terms }}"</h1>
  <p>{{ 'search_page.results_count' | t: count: search.results_count }}</p>
</div></section>

<section><div class="wrap">
  <form action="{{ routes.search_url }}" method="get" style="margin-bottom:32px;max-width:420px">
    <input type="search" name="q" class="shopSearchInput" style="width:100%" placeholder="{{ 'general.search.placeholder' | t }}" value="{{ search.terms | escape }}">
    <input type="hidden" name="type" value="product">
  </form>

  {% if search.results.size == 0 %}
    <p class="noResults">{{ 'search_page.no_results' | t: terms: search.terms }}</p>
  {% else %}
    <div class="products">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div></section>

{% schema %}
{ "name": "Zoeken" }
{% endschema %}
