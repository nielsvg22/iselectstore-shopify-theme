{% assign eyebrow_default = 'home_story_cta.eyebrow' | t %}
{% assign heading_default = 'home_story_cta.heading' | t %}
{% assign text_default = 'home_story_cta.text' | t %}
{% assign button_default = 'home_story_cta.button' | t %}

{% assign story_url = '' %}
{% if pages['over-ons'] %}{% assign story_url = pages['over-ons'].url %}{% endif %}
{% assign button_url = section.settings.button_link | default: story_url %}

<section class="stSection stHomeCtaSection"><div class="wrap">
  <div class="stHomeCta reveal">
    <span class="stHomeCtaMark" aria-hidden="true">
      {% render 'icon-mark', size: 26 %}
    </span>
    <p class="eyebrow">{{ section.settings.eyebrow | default: eyebrow_default }}</p>
    <h2>{{ section.settings.heading | default: heading_default }}</h2>
    <p class="sub">{{ section.settings.text | default: text_default }}</p>
    {% if button_url != blank %}
      <a class="btn stHomeCtaBtn" href="{{ button_url }}">{{ section.settings.button_label | default: button_default }}</a>
    {% endif %}
  </div>
</div></section>

{% schema %}
{
  "name": "Homepage — Ons verhaal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "button_label", "label": "Knop-tekst" },
    { "type": "url", "id": "button_link", "label": "Knop-link (standaard: pagina 'Ons verhaal')" }
  ],
  "presets": [{ "name": "Homepage — Ons verhaal" }]
}
{% endschema %}
