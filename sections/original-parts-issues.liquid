{% comment %}
  Lijst met concrete problemen door niet-originele onderdelen — overgenomen
  van de "Waarom origineel?"-pagina op bestbuyphone.nl, aangepast aan de
  huisstijl van iSelectStore.
{% endcomment %}
<section class="stSection"><div class="wrap" style="max-width:780px">
  <p class="eyebrow reveal">{{ section.settings.eyebrow | default: 'original_parts_issues.eyebrow' | t }}</p>
  {% assign heading_default = 'original_parts_issues.heading' | t %}
  <h2 class="reveal">{{ section.settings.heading | default: heading_default }}</h2>
  {% assign intro_default = 'original_parts_issues.intro' | t %}
  <p class="sub reveal">{{ section.settings.intro | default: intro_default }}</p>

  <ul class="opiList reveal">
    {% for i in (1..9) %}
      {% assign item_key = 'original_parts_issues.items.' | append: i %}
      {% assign item = item_key | t %}
      {% unless item contains 'translation missing' %}
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="13"></line><circle cx="12" cy="16" r="0.5" fill="currentColor"></circle></svg>
          <span>{{ item }}</span>
        </li>
      {% endunless %}
    {% endfor %}
  </ul>

  {% assign outro_default = 'original_parts_issues.outro' | t %}
  <p class="opiOutro reveal">{{ section.settings.outro | default: outro_default }}</p>
</div></section>

{% schema %}
{
  "name": "Problemen niet-origineel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "intro", "label": "Introtekst" },
    { "type": "textarea", "id": "outro", "label": "Slottekst" }
  ],
  "presets": [{ "name": "Problemen niet-origineel" }]
}
{% endschema %}
