{% assign eyebrow_default = 'story_page.person.eyebrow' | t %}
{% assign heading_default = 'story_page.person.heading_default' | t %}
{% assign quote_default = 'story_page.person.quote_default' | t %}

<section class="stSection stSoft" id="story-person"><div class="wrap">
  <div class="stPerson reveal">
    <div class="stPersonMedia">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 700 }}"
          srcset="{{ section.settings.image | image_url: width: 450 }} 450w, {{ section.settings.image | image_url: width: 700 }} 700w"
          sizes="(max-width: 899px) 68vw, 300px"
          width="700" height="700"
          alt="{{ section.settings.image.alt | default: section.settings.name | default: shop.name | escape }}"
          loading="lazy">
      {% else %}
        <div class="stPersonPlaceholder" aria-hidden="true">
          <svg class="stMark" viewBox="0 0 24 24"><path d="M12 0c.9 3.2 2 5.6 3.4 7.1C16.9 8.6 19.2 9.7 22.4 10.6c-3.2.9-5.5 2-7 3.5C13.9 15.6 12.8 18 12 21.1c-.8-3.1-1.9-5.5-3.4-7C7.1 12.6 4.8 11.5 1.6 10.6c3.2-.9 5.5-2 7-3.5C10.1 5.6 11.2 3.2 12 0z"/></svg>
        </div>
      {% endif %}
    </div>

    <div class="stPersonCopy">
      <p class="eyebrow">{{ section.settings.eyebrow | default: eyebrow_default }}</p>
      <h2>{{ section.settings.heading | default: heading_default }}</h2>
      <blockquote class="stQuote">
        <span class="stQuoteMark" aria-hidden="true">&ldquo;</span>
        {{ section.settings.quote | default: quote_default }}
      </blockquote>
      {% if section.settings.name != blank %}
        <p class="stPersonBy">
          <b>{{ section.settings.name }}</b>
          {% if section.settings.role != blank %}<span>{{ section.settings.role }}</span>{% endif %}
        </p>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="stRich stRich--small">{{ section.settings.text }}</div>
      {% endif %}
    </div>
  </div>
</div></section>

{% schema %}
{
  "name": "Verhaal-persoonlijk",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "text", "id": "quote", "label": "Quote" },
    { "type": "text", "id": "name", "label": "Naam" },
    { "type": "text", "id": "role", "label": "Functie / rol" },
    { "type": "richtext", "id": "text", "label": "Korte toelichting" },
    { "type": "image_picker", "id": "image", "label": "Foto" }
  ]
}
{% endschema %}
