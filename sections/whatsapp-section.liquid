{% comment %}
  WhatsApp contact section
  - Configureerbaar nummer en bericht via thema-instellingen
  - Geen zwevende knop; plaatsbaar als section
{% endcomment %}

{% assign number = section.settings.whatsapp_number | default: settings.whatsapp_number | default: '31643295022' %}
{% assign message = section.settings.whatsapp_message | default: settings.whatsapp_default_message | default: 'Hoi%20iSelectStore%2C%20ik%20heb%20een%20vraag.' %}
{% assign link = 'https://wa.me/' | append: number | append: '?text=' | append: message %}

{% if number != blank %}
  <section class="whatsapp-section" data-section-id="{{ section.id }}">
    <div class="wrap">
      <div class="whatsapp-section__box">
        <div>
          <p class="eyebrow">Direct contact</p>
          <h2>{{ section.settings.heading | default: "Vragen over dit product?" }}</h2>
          <p class="sub">{{ section.settings.text | default: "We reageren meestal binnen enkele minuten via WhatsApp." }}</p>
        </div>
        <a href="{{ link }}" target="_blank" rel="noopener" class="btn primary">
          {{ section.settings.button_text | default: "Stuur een WhatsApp →" }}
        </a>
      </div>
    </div>
  </section>

  <style>
    .whatsapp-section { padding: 40px 0; }
    .whatsapp-section__box {
      background: var(--soft);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }
    .whatsapp-section__box h2 { margin: 0 0 4px; font-size: 24px; }
    .whatsapp-section__box .sub { margin: 0; }
  </style>
{% endif %}

{% schema %}
{
  "name": "WhatsApp contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Vragen over dit product?" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "We reageren meestal binnen enkele minuten via WhatsApp." },
    { "type": "text", "id": "button_text", "label": "Knoptekst", "default": "Stuur een WhatsApp →" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp nummer", "info": "Internationaal formaat zonder +. Overschrijft thema-instelling." },
    { "type": "text", "id": "whatsapp_message", "label": "WhatsApp bericht (URL-encoded)", "info": "Overschrijft thema-instelling." }
  ],
  "presets": [
    { "name": "WhatsApp contact" }
  ]
}
{% endschema %}
