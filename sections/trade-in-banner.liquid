<section><div class="wrap reveal">
  <div class="trade">
    <div class="tradecopy">
      {% assign trade_heading_default = 'trade_in.banner_heading_default' | t %}
      {% assign trade_subtext_default = 'trade_in.banner_subtext_default' | t %}
      <div class="eye">{{ 'trade_in.banner_eyebrow' | t }}</div>
      <h2>{{ section.settings.heading | default: trade_heading_default }}</h2>
      <p class="lead" style="font-size:16px">{{ section.settings.subtext | default: trade_subtext_default }}</p>
      <a class="btn primary js-tradein-trigger" href="#" style="margin-top:20px">{{ 'trade_in.banner_cta' | t }}</a>
    </div>
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 800 }}" width="800" height="400" alt="{{ 'trade_in.banner_image_alt' | t }}">
    {% endif %}
  </div>
</div></section>

{% schema %}
{
  "name": "Inruil-banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "subtext", "label": "Subtekst" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding" }
  ],
  "presets": [{ "name": "Inruil-banner" }]
}
{% endschema %}
