<section class="hero"><div class="heroIn" style="grid-template-columns:1fr;text-align:center;min-height:60vh">
  <div style="max-width:480px;margin:auto">
    <div class="logo" style="justify-content:center;font-size:26px;margin-bottom:22px">
      <svg class="mark" viewBox="0 0 24 24" style="width:24px;height:24px"><path d="M12 0c.9 3.2 2 5.6 3.4 7.1C16.9 8.6 19.2 9.7 22.4 10.6c-3.2.9-5.5 2-7 3.5C13.9 15.6 12.8 18 12 21.1c-.8-3.1-1.9-5.5-3.4-7C7.1 12.6 4.8 11.5 1.6 10.6c3.2-.9 5.5-2 7-3.5C10.1 5.6 11.2 3.2 12 0z"/></svg>
      {{ shop.name | default: 'iSelectStore' }}
    </div>
    <div class="eye" style="justify-content:center">selected by us, ready for you</div>
    <h1>Only the<br><span>good ones.</span></h1>
    <p class="lead" style="margin:auto">{{ section.settings.message | default: "Onze webshop is bijna klaar. Heb je een toegangscode ontvangen? Vul 'm hieronder in." }}</p>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <p style="color:var(--coral-ink);font-weight:600;margin-top:16px">{{ form.errors.messages['form'] }}</p>
      {% endif %}
      <div class="formRow" style="margin-top:24px">
        <input type="password" name="password" placeholder="Wachtwoord" required>
      </div>
      <button class="btn primary" type="submit" style="width:100%;justify-content:center;margin-top:14px">Winkel openen →</button>
    {% endform %}
  </div>
</div></section>

{% schema %}
{
  "name": "Wachtwoordpagina",
  "settings": [
    { "type": "textarea", "id": "message", "label": "Boodschap boven het wachtwoordveld" }
  ]
}
{% endschema %}
