<section class="hero"><div class="heroIn" style="grid-template-columns:1fr;text-align:center;min-height:60vh">
  <div style="max-width:480px;margin:auto">
    <div class="logo" style="justify-content:center;font-size:26px;margin-bottom:22px">
      {% render 'icon-mark', size: 24 %}
      <span class="logo-strong">iSelect</span><span class="logo-light">Store</span>
    </div>
    <div class="eye" style="justify-content:center">selected by us, ready for you</div>
    <h1>{{ 'password_page.title_line_1' | t }}<br><span>{{ 'password_page.title_line_2' | t }}</span></h1>
    <p class="lead" style="margin:auto">{% assign password_message_default = 'password_page.message_default' | t %}
    {{ section.settings.message | default: password_message_default }}</p>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <p style="color:var(--coral-ink);font-weight:600;margin-top:16px">{{ form.errors.messages['form'] }}</p>
      {% endif %}
      <div class="formRow" style="margin-top:24px">
        <input type="password" name="password" placeholder="{{ 'password_page.password_placeholder' | t }}" required>
      </div>
      <button class="btn primary" type="submit" style="width:100%;justify-content:center;margin-top:14px">{{ 'password_page.submit' | t }}</button>
    {% endform %}
  </div>
</div></section>

{% schema %}
{
  "name": "Wachtwoordpagina",
  "settings": [
    { "type": "textarea", "id": "message", "label": "Boodschap boven het wachtwoordveld" }
  ]
}
{% endschema %}
