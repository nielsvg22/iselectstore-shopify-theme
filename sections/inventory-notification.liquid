{% comment %}
  Voorraadmelding formulier
  - Toont alleen bij uitverkochte producten
  - Stuurt e-mail + productidentiteit naar backend API
  - Hergebruikt bestaande theme classes
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

{% if current_variant.available == false %}
  {% assign product_type = product.type | default: '' %}
  {% assign storage = product.metafields.custom.storage_gb | default: '' %}
  {% assign storage_with_unit = storage | append: 'GB' %}

  {% comment %} Model bepalen: voorkeur voor custom.model, anders opslag uit titel verwijderen {% endcomment %}
  {% assign model = product.metafields.custom.model | default: '' %}
  {% if model == '' %}
    {% assign title_without_storage = product.title | remove: storage_with_unit | strip %}
    {% assign title_without_storage_num = product.title | remove: storage | strip %}
    {% assign model = title_without_storage | default: title_without_storage_num | default: product.title %}
  {% endif %}

  <section class="inventory-notification" data-section-id="{{ section.id }}">
    <div class="wrap">
      <div class="inventory-notification__box">
        <h3 class="inventory-notification__title">{{ section.settings.heading | default: "Ontvang een melding wanneer dit product weer beschikbaar is" }}</h3>
        <p class="inventory-notification__text">{{ section.settings.text | default: "Vul je e-mailadres in. We sturen je één bericht zodra dit model en opslag weer op voorraad is." }}</p>

        <form class="inventory-notification__form" data-inventory-form>
          <input type="hidden" name="productType" value="{{ product_type | escape }}">
          <input type="hidden" name="model" value="{{ model | escape }}">
          <input type="hidden" name="storage" value="{{ storage_with_unit | escape }}">

          <input
            type="email"
            name="email"
            class="shopSearchInput"
            placeholder="je@email.nl"
            required
            aria-label="E-mailadres"
          >
          <button type="submit" class="btn primary">{{ section.settings.button_text | default: "Houd mij op de hoogte" }}</button>
        </form>

        <p class="inventory-notification__message" data-inventory-message role="status" style="display:none;"></p>
      </div>
    </div>
  </section>

  <style>
    .inventory-notification { padding: 24px 0 56px; }
    .inventory-notification__box {
      background: var(--soft);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 24px;
      max-width: 560px;
    }
    .inventory-notification__title {
      font-size: 18px;
      font-weight: 700;
      color: var(--navy);
      margin: 0 0 8px;
    }
    .inventory-notification__text {
      font-size: 14px;
      color: var(--muted);
      margin: 0 0 18px;
      line-height: 1.5;
    }
    .inventory-notification__form {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .inventory-notification__form .shopSearchInput {
      flex: 1;
      min-width: 220px;
    }
    .inventory-notification__message {
      margin: 14px 0 0;
      font-size: 14px;
      font-weight: 600;
      color: var(--navy);
    }
    .inventory-notification__message.is-error { color: #dc2626; }
  </style>

  <script>
    (function () {
      var form = document.querySelector('[data-inventory-form]');
      if (!form) return;
      var message = document.querySelector('[data-inventory-message]');
      var appUrl = {{ section.settings.backend_url | default: 'https://iselectstore-marktplaats-app.vercel.app' | json }};

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var data = {
          email: form.email.value,
          productType: form.productType.value,
          model: form.model.value,
          storage: form.storage.value
        };
        fetch(appUrl + '/api/inventory/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })
          .then(function (r) { return r.json(); })
          .then(function (res) {
            message.style.display = 'block';
            message.classList.remove('is-error');
            message.textContent = res.message || 'Bedankt! Je krijgt een melding zodra dit product weer beschikbaar is.';
            form.reset();
          })
          .catch(function () {
            message.style.display = 'block';
            message.classList.add('is-error');
            message.textContent = 'Er ging iets mis. Probeer het later opnieuw.';
          });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Voorraadmelding",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Ontvang een melding wanneer dit product weer beschikbaar is" },
    { "type": "textarea", "id": "text", "label": "Omschrijving", "default": "Vul je e-mailadres in. We sturen je één bericht zodra dit model en opslag weer op voorraad is." },
    { "type": "text", "id": "button_text", "label": "Knoptekst", "default": "Houd mij op de hoogte" },
    { "type": "text", "id": "backend_url", "label": "Backend app URL", "default": "https://iselectstore-marktplaats-app.vercel.app" }
  ],
  "presets": [
    { "name": "Voorraadmelding" }
  ]
}
{% endschema %}
