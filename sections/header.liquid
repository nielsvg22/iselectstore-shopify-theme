{% assign portal_default_url = routes.search_url | append: '?view=mijn-account' %}
{% if pages['mijn-account'] != blank %}{% assign portal_default_url = pages['mijn-account'].url %}{% endif %}
{% assign portal_url = section.settings.account_portal_url | default: portal_default_url %}

<header id="siteHeader"><div class="nav">
  <button class="burger" id="burger" aria-label="{{ 'header.menu_aria' | t }}"><span></span><span></span><span></span></button>
  <a class="logo" href="{{ routes.root_url }}">
    {% render 'brand-logo', loading: 'eager' %}
  </a>
  <nav class="links">
    <a href="{{ routes.root_url }}">{{ 'header.nav.home' | t }}</a>
    <a href="{{ section.settings.shop_collection.url | default: routes.all_products_collection_url }}">{{ 'header.nav.stock' | t }}</a>
    {% if pages['originele-iphone'] %}<a href="{{ pages['originele-iphone'].url }}">{{ 'header.nav.original_iphone' | t }}</a>{% endif %}
    {% if pages['over-ons'] %}<a href="{{ pages['over-ons'].url }}">{{ 'header.nav.our_story' | t }}</a>{% endif %}
    {% if pages.faq %}<a href="{{ pages.faq.url }}">{{ 'header.nav.faq' | t }}</a>{% endif %}
    <a class="js-tradein-trigger" href="#">{{ 'header.nav.trade_in' | t }}</a>
    {% if pages.contact %}<a href="{{ pages.contact.url }}">{{ 'header.nav.contact' | t }}</a>{% endif %}
  </nav>
  <div class="icons">
    <button class="ic" aria-label="{{ 'general.search.aria' | t }}" id="searchIcon"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
    <a class="ic" href="{{ routes.search_url }}" style="display:none" id="searchLink"></a>
    <a class="ic" href="{{ portal_url | escape }}" aria-label="{{ 'header.account_aria' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>
    </a>
    <a class="ic" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart_aria' | t }}"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16l1 14H3ZM8 7V6a4 4 0 0 1 8 0v1"/></svg><span class="count">{{ cart.item_count }}</span></a>
    {% if shop.enabled_locales.size > 1 %}
      <a class="ic icLang" href="#language-selector" aria-label="{{ 'language_selector.label' | t }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
      </a>
    {% endif %}
  </div>
</div></header>

<div class="top" id="uspBar"><div class="topin">
  <div class="topPair is-active"><span>{{ 'header.top.original_products' | t }}</span></div>
  <div class="topPair"><span>{{ 'header.top.product_photos' | t }}</span></div>
  <div class="topPair"><span>{{ 'header.top.best_price' | t }}</span></div>
  <div class="topPair"><span>{{ 'header.top.battery_condition' | t }}</span></div>
  <div class="topPair"><span>{{ 'header.top.trade_in' | t }}</span></div>
  <div class="topPair"><span>{{ 'header.top.warranty' | t }}</span></div>
</div></div>

<div class="mnav" id="mnav">
  <div class="mnavOverlay" id="mnavOverlay"></div>
  <div class="mnavPanel">
    <button type="button" class="mnavClose" id="mnavClose" aria-label="{{ 'general.search.close_aria' | t }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
    </button>
    <nav class="mnavLinks">
      <a href="{{ routes.root_url }}">{{ 'header.nav.home' | t }}</a>
      <a href="{{ section.settings.shop_collection.url | default: routes.all_products_collection_url }}">{{ 'header.nav.stock' | t }}</a>
      {% if pages['originele-iphone'] %}<a href="{{ pages['originele-iphone'].url }}">{{ 'header.nav.original_iphone' | t }}</a>{% endif %}
      {% if pages['over-ons'] %}<a href="{{ pages['over-ons'].url }}">{{ 'header.nav.our_story' | t }}</a>{% endif %}
      {% if pages.faq %}<a href="{{ pages.faq.url }}">{{ 'header.nav.faq' | t }}</a>{% endif %}
      <a class="js-tradein-trigger" href="#">{{ 'header.nav.trade_in' | t }}</a>
      {% if pages.contact %}<a href="{{ pages.contact.url }}">{{ 'header.nav.contact' | t }}</a>{% endif %}
      <a href="{{ portal_url | escape }}">{{ 'header.nav.account' | t }}</a>
      {% if shop.enabled_locales.size > 1 %}<a href="#language-selector">{{ 'language_selector.label' | t }}</a>{% endif %}
      <a class="primary" href="{{ section.settings.shop_collection.url | default: routes.all_products_collection_url }}">{{ 'header.mobile_cta' | t }}</a>
    </nav>
  </div>
</div>

<form action="{{ routes.search_url }}" method="get" role="search" class="tiOverlay" id="searchOverlay">
  <div class="tiModal" style="max-width:560px">
    <button type="button" class="tiClose" id="searchClose" aria-label="{{ 'general.search.close_aria' | t }}">×</button>
    <p class="tiEyebrow">{{ 'general.search.aria' | t }}</p>
    <h3>{{ 'general.search.title' | t }}</h3>
    <input type="search" name="q" class="shopSearchInput" style="width:100%" placeholder="{{ 'general.search.input_placeholder' | t }}" value="{{ search.terms | escape }}" autofocus autocomplete="off">
    <input type="hidden" name="type" value="product">
    <div class="searchSuggest" data-search-suggest hidden></div>
    <button type="submit" class="btn primary" style="width:100%;margin-top:14px;justify-content:center">{{ 'general.search.cta' | t }}</button>
  </div>
</form>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "collection", "id": "shop_collection", "label": "Voorraad-collectie (koppeling 'Voorraad' in menu)" },
    { "type": "url", "id": "account_portal_url", "label": "Klantenportaal URL", "info": "Leeg = pagina mijn-account indien aanwezig, anders het klantenportaal in het thema." }
  ]
}
{% endschema %}
