{% assign portal_url = section.settings.account_portal_url | default: routes.account_url %}
<div class="top"><div class="topin">
  <span>{{ 'header.top.original_products' | t }}</span><span>{{ 'header.top.battery_condition' | t }}</span><span>{{ 'header.top.warranty' | t }}</span><span>{{ 'header.top.trade_in' | t }}</span>
</div></div>

<header id="siteHeader"><div class="nav">
  <a class="logo" href="{{ routes.root_url }}">
    {% render 'icon-mark', size: 20 %}
    <span class="logo-strong">iSelect</span><span class="logo-light">Store</span>
  </a>
  <nav class="links">
    <a href="{{ routes.root_url }}">{{ 'header.nav.home' | t }}</a>
    <a href="{{ section.settings.shop_collection.url | default: routes.all_products_collection_url }}">{{ 'header.nav.stock' | t }}</a>
    {% if pages['originele-iphone'] %}<a href="{{ pages['originele-iphone'].url }}">{{ 'header.nav.original_iphone' | t }}</a>{% endif %}
    {% if pages['over-ons'] %}<a href="{{ pages['over-ons'].url }}">{{ 'header.nav.our_story' | t }}</a>{% endif %}
    {% if pages.faq %}<a href="{{ pages.faq.url }}">{{ 'header.nav.faq' | t }}</a>{% endif %}
    <a class="js-tradein-trigger" href="#">{{ 'header.nav.trade_in' | t }}</a>
    {% if pages.contact %}<a href="{{ pages.contact.url }}">{{ 'header.nav.contact' | t }}</a>{% endif %}
  </nav>
  <div class="icons">
    <button class="ic" aria-label="{{ 'general.search.aria' | t }}" id="searchIcon">🔍</button>
    <a class="ic" href="{{ routes.search_url }}" style="display:none" id="searchLink"></a>
    <a class="ic" href="{{ portal_url | escape }}" aria-label="{{ 'header.account_aria' | t }}" style="width:44px;height:44px;margin:-13px">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>
    </a>
    <a class="ic" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart_aria' | t }}">🛍<span class="count">{{ cart.item_count }}</span></a>
    <button class="burger" id="burger" aria-label="{{ 'header.menu_aria' | t }}"><span></span><span></span><span></span></button>
  </div>
</div></header>

<nav class="mnav" id="mnav">
  <a href="{{ routes.root_url }}">{{ 'header.nav.home' | t }}</a>
  <a href="{{ section.settings.shop_collection.url | default: routes.all_products_collection_url }}">{{ 'header.nav.stock' | t }}</a>
  {% if pages['originele-iphone'] %}<a href="{{ pages['originele-iphone'].url }}">{{ 'header.nav.original_iphone' | t }}</a>{% endif %}
  {% if pages['over-ons'] %}<a href="{{ pages['over-ons'].url }}">{{ 'header.nav.our_story' | t }}</a>{% endif %}
  {% if pages.faq %}<a href="{{ pages.faq.url }}">{{ 'header.nav.faq' | t }}</a>{% endif %}
  <a class="js-tradein-trigger" href="#">{{ 'header.nav.trade_in' | t }}</a>
  {% if pages.contact %}<a href="{{ pages.contact.url }}">{{ 'header.nav.contact' | t }}</a>{% endif %}
  <a href="{{ portal_url | escape }}">{{ 'header.nav.account' | t }}</a>
  <a class="btn primary" href="{{ section.settings.shop_collection.url | default: routes.all_products_collection_url }}">{{ 'header.mobile_cta' | t }}</a>
</nav>

<form action="{{ routes.search_url }}" method="get" role="search" class="tiOverlay" id="searchOverlay">
  <div class="tiModal" style="max-width:560px">
    <button type="button" class="tiClose" id="searchClose" aria-label="{{ 'general.search.close_aria' | t }}">×</button>
    <p class="tiEyebrow">{{ 'general.search.aria' | t }}</p>
    <h3>{{ 'general.search.title' | t }}</h3>
    <input type="search" name="q" class="shopSearchInput" style="width:100%" placeholder="{{ 'general.search.input_placeholder' | t }}" value="{{ search.terms | escape }}" autofocus>
    <input type="hidden" name="type" value="product">
    <button type="submit" class="btn primary" style="width:100%;margin-top:14px;justify-content:center">{{ 'general.search.cta' | t }}</button>
  </div>
</form>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "collection", "id": "shop_collection", "label": "Voorraad-collectie (koppeling 'Voorraad' in menu)" },
    { "type": "url", "id": "account_portal_url", "label": "Klantenportaal URL", "info": "Plak na activatie de volledige URL van Mijn iSelectStore uit de Shopify account-editor. Leeg = officieel Shopify-account." }
  ]
}
{% endschema %}
