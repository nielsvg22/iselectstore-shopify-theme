<section id="categorie"><div class="wrap reveal">
  <div class="head">
    <div>
      <p class="eyebrow">{{ 'featured_categories.eyebrow' | t }}</p>
      {% assign categories_heading_default = 'featured_categories.heading_default' | t %}
      <h2>{{ section.settings.heading | default: categories_heading_default }}</h2>
      <p class="sub">{{ section.settings.subtext }}</p>
    </div>
  </div>
  <div class="cats">
    {% for block in section.blocks %}
      <a class="cat" href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>
        {% liquid
          assign category_photo = blank
          case block.settings.collection.handle
            when 'apple-iphone'
              assign category_photo = 'category-iphone.webp'
            when 'apple-ipad'
              assign category_photo = 'category-ipad.webp'
            when 'apple-macbooks'
              assign category_photo = 'category-macbook.webp'
            when 'apple-watch'
              assign category_photo = 'category-watch.webp'
          endcase
          assign category_alt = block.settings.label | default: block.settings.collection.title
        %}
        {% if block.settings.image %}
          <img src="{{ block.settings.image | image_url: width: 900 }}" width="900" height="900" loading="lazy" decoding="async" alt="{{ category_alt | escape }}">
        {% elsif category_photo != blank %}
          <img src="{{ category_photo | asset_url }}" width="744" height="790" loading="lazy" decoding="async" alt="{{ category_alt | escape }}">
        {% elsif block.settings.collection.featured_image %}
          <img src="{{ block.settings.collection.featured_image | image_url: width: 900 }}" width="900" height="900" loading="lazy" decoding="async" alt="{{ category_alt | escape }}">
        {% endif %}
        <div class="catcopy"><b>{{ block.settings.label | default: block.settings.collection.title }}</b><span>{{ 'featured_categories.cta' | t }}</span></div>
      </a>
    {% endfor %}
  </div>
</div></section>

{% schema %}
{
  "name": "Categorieën",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtekst"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collectie"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (optioneel, overschrijft collectienaam)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding (optioneel, anders collectie-afbeelding)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "category",
        "settings": {
          "label": "Apple iPhone"
        }
      },
      {
        "type": "category",
        "settings": {
          "label": "Tablets | Apple iPad"
        }
      },
      {
        "type": "category",
        "settings": {
          "label": "Apple MacBooks"
        }
      },
      {
        "type": "category",
        "settings": {
          "label": "Apple Watch"
        }
      }
    ]
  }
}
{% endschema %}
