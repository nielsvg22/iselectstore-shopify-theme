{% comment %}
  WebwinkelKeur reviewwidget.
  - Toont de officiële <valued-widget>-embedcode die WebwinkelKeur zelf
    genereert in hun dashboard (Widgets → Ontvang de code). Dat custom
    element rendert pas zodra de bijbehorende loader geladen is — en die
    loader wordt automatisch toegevoegd door de gratis "WebwinkelKeur" app
    uit de Shopify App Store (WebwinkelKeur raadt voor Shopify zelf die app
    aan i.p.v. een handmatig <script>-tag, en levert daar geen los
    installatiescript voor). Zodra die app geïnstalleerd is, "activeert"
    deze tag vanzelf — er hoeft dan niets aan deze sectie te veranderen.
    Webwinkel-ID bij installatie van de app: zie thema-instellingen.
{% endcomment %}

{% assign default_embed = '<valued-widget layout="reviews" size="medium" align="center" theme="light"></valued-widget>' %}
{% assign embed = section.settings.widget_embed | default: default_embed %}

{% if embed != blank %}
  <section class="webwinkelkeur" data-section-id="{{ section.id }}">
    <div class="wrap">
      {% assign wkw_heading_default = 'webwinkelkeur.heading_default' | t %}
      {% assign wkw_heading = section.settings.heading | default: wkw_heading_default %}
      {% if wkw_heading != blank %}
        <div class="head">
          <div>
            <p class="eyebrow">WebwinkelKeur</p>
            <h2>{{ wkw_heading }}</h2>
          </div>
        </div>
      {% endif %}
      <div class="wwkWidget">{{ embed }}</div>
    </div>
  </section>

  <style>
    .webwinkelkeur { background: var(--ivory); }
    .wwkWidget { display: flex; justify-content: center; }
  </style>
{% endif %}

{% schema %}
{
  "name": "WebwinkelKeur",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel" },
    {
      "type": "html",
      "id": "widget_embed",
      "label": "Widget-embedcode",
      "info": "De <valued-widget>-code uit het WebwinkelKeur-dashboard (Widgets → Ontvang de code). Rendert pas zodra de gratis WebwinkelKeur Shopify-app is geïnstalleerd."
    }
  ],
  "presets": [
    {
      "name": "WebwinkelKeur",
      "settings": {
        "widget_embed": "<valued-widget layout=\"reviews\" size=\"medium\" align=\"center\" theme=\"light\"></valued-widget>"
      }
    }
  ]
}
{% endschema %}
