{% comment %}
  WebwinkelKeur widget section
  - Laadt alleen als WEBWINKELKEUR_SHOP_ID is geconfigureerd
  - Gebruikt officiële WebwinkelKeur widget code
{% endcomment %}

{% assign shop_id = section.settings.shop_id | default: settings.webwinkelkeur_shop_id %}

{% if shop_id != blank %}
  <section class="webwinkelkeur" data-section-id="{{ section.id }}">
    <div class="wrap">
      {% if section.settings.heading != blank %}
        <div class="head">
          <div>
            <p class="eyebrow">WebwinkelKeur</p>
            <h2>{{ section.settings.heading }}</h2>
          </div>
        </div>
      {% endif %}
      <div id="webwinkelkeur-widget" style="min-height:120px;"></div>
    </div>
  </section>

  <script>
    (function () {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.webwinkelkeur.nl/widget.js?id={{ shop_id }}';
      document.body.appendChild(s);
    })();
  </script>

  <style>
    .webwinkelkeur { background: var(--ivory); }
  </style>
{% endif %}

{% schema %}
{
  "name": "WebwinkelKeur",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Wat klanten van ons vinden" },
    { "type": "text", "id": "shop_id", "label": "WebwinkelKeur shop ID", "info": "Als leeg wordt de waarde uit thema-instellingen gebruikt." }
  ],
  "presets": [
    { "name": "WebwinkelKeur" }
  ]
}
{% endschema %}
