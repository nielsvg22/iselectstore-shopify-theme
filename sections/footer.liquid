          <option value="iPhone 15 plus" data-type="iPhone">iPhone 15 plus</option>
          <option value="iPhone 15 Pro" data-type="iPhone">iPhone 15 Pro</option>
          <option value="iPhone 15 Pro Max" data-type="iPhone">iPhone 15 Pro Max</option>
          <option value="iPhone 16" data-type="iPhone">iPhone 16</option>
          <option value="iPhone 16 Plus" data-type="iPhone">iPhone 16 Plus</option>
          <option value="iPhone 16 Pro" data-type="iPhone">iPhone 16 Pro</option>
          <option value="iPhone 16 Pro Max" data-type="iPhone">iPhone 16 Pro Max</option>
          <option value="iPhone 16E" data-type="iPhone">iPhone 16E</option>
          <option value="iPhone 17" data-type="iPhone">iPhone 17</option>
          <option value="iPhone 17 Air" data-type="iPhone">iPhone 17 Air</option>
          <option value="iPhone 17 Pro" data-type="iPhone">iPhone 17 Pro</option>
          <option value="iPhone 17 Pro Max" data-type="iPhone">iPhone 17 Pro Max</option>
          <option value="iPhone 17e" data-type="iPhone">iPhone 17e</option>
          <option value="iPhone Air" data-type="iPhone">iPhone Air</option>
          <option value="iPhone SE 2022" data-type="iPhone">iPhone SE 2022</option>
        </optgroup>
        <optgroup label="iPad">
          <option value="iPad 9e" data-type="iPad">iPad 9e</option>
