<footer><div class="wrap">
  <div class="footer">
    <div class="footerBrand">
      <a class="logo" href="{{ routes.root_url }}">
        <svg class="mark" viewBox="0 0 24 24"><path d="M12 0c.9 3.2 2 5.6 3.4 7.1C16.9 8.6 19.2 9.7 22.4 10.6c-3.2.9-5.5 2-7 3.5C13.9 15.6 12.8 18 12 21.1c-.8-3.1-1.9-5.5-3.4-7C7.1 12.6 4.8 11.5 1.6 10.6c3.2-.9 5.5-2 7-3.5C10.1 5.6 11.2 3.2 12 0z"/></svg>
        {{ shop.name | default: 'iSelectStore' }}
      </a>
      <p style="margin-top:14px">{{ section.settings.brand_text | default: "Premium pre-owned originele Apple-producten met volledige transparantie over conditie en batterijstatus." }}</p>
      <div class="socialRow">
        {% if section.settings.whatsapp != blank %}<a class="socialIc" href="https://wa.me/{{ section.settings.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.9 14.3c-.2.6-1.2 1.2-1.7 1.3-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.5-3.9-4.6-4.1-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.9 1.4 1.9 2.3 1.3 1.1 2.4 1.5 2.7 1.6.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.8.8.3.1.5.2.5.3.1.2.1.6-.1 1.2z"/></svg></a>{% endif %}
        {% if settings.social_instagram_link != blank %}<a class="socialIc" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>{% endif %}
        {% if settings.social_facebook_link != blank %}<a class="socialIc" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5H16l.4-3H13.5V8.4c0-.9.2-1.5 1.5-1.5H16.5V4.2C16.2 4.1 15.2 4 14 4c-2.4 0-4 1.5-4 4.1v2.4H7.5v3H10V21h3.5z"/></svg></a>{% endif %}
      </div>
    </div>

    <div>
      <h4>{{ 'footer.headings.iphones' | t }}</h4>
      <a href="{{ section.settings.shop_collection.url | default: routes.all_products_collection_url }}">{{ 'footer.links.stock' | t }}</a>
      {% if pages['originele-iphone'] %}<a href="{{ pages['originele-iphone'].url }}">{{ 'footer.links.original_iphone' | t }}</a>{% endif %}
      <a class="js-tradein-trigger" href="#">{{ 'footer.links.trade_in' | t }}</a>
      <a class="js-tradein-trigger" href="#">{{ 'footer.links.value_estimate' | t }}</a>
    </div>

    <div>
      <h4>{{ 'footer.headings.information' | t }}</h4>
      <a href="{{ routes.root_url }}">{{ 'footer.links.homepage' | t }}</a>
      {% if pages.contact %}<a href="{{ pages.contact.url }}">{{ 'header.nav.contact' | t }}</a>{% endif %}
      {% if pages.faq %}<a href="{{ pages.faq.url }}">{{ 'footer.links.faq' | t }}</a>{% endif %}
      {% for policy in shop.policies %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endfor %}
    </div>

    <div>
      <h4>{{ 'footer.headings.contact' | t }}</h4>
      <p>{{ section.settings.phone }}</p>
      <p>{{ shop.email }}</p>
      <p>{{ section.settings.address }}</p>
    </div>
  </div>

  <div class="newsletter">
    <div><b>{{ 'footer.newsletter.title' | t }}</b><p>{{ 'footer.newsletter.subtext' | t }}</p></div>
    {% form 'customer', id: 'footerNewsletter' %}
      {% if form.posted_successfully? %}
        <span class="newsletterDone">{{ 'footer.newsletter.thanks' | t }}</span>
      {% else %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletterForm">
          <input type="email" name="contact[email]" placeholder="{{ 'footer.newsletter.placeholder' | t }}" required>
          <button class="btn primary" type="submit">{{ 'footer.newsletter.cta' | t }}</button>
        </div>
      {% endif %}
    {% endform %}
  </div>

  <div class="footerBadges">
    <span>★★★★★ {{ section.settings.rating | default: "9,8/10" }} {{ 'footer.badges.reviews_suffix' | t }}</span>
    <span>{{ section.settings.review_count | default: "607+" }} {{ 'footer.badges.reviews_count_suffix' | t }}</span>
    {% if section.settings.kvk %}<span>{{ 'footer.badges.kvk' | t }} {{ section.settings.kvk }}</span>{% endif %}
    {% if section.settings.btw %}<span>{{ 'footer.badges.btw' | t }} {{ section.settings.btw }}</span>{% endif %}
  </div>

  <div class="finePrint">Copyright © {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
</div></footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "collection", "id": "shop_collection", "label": "Voorraad-collectie" },
    { "type": "text", "id": "brand_text", "label": "Beschrijving onder logo" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp nummer (bv. 31643295022)" },
    { "type": "text", "id": "phone", "label": "Telefoonnummer" },
    { "type": "text", "id": "address", "label": "Adres" },
    { "type": "text", "id": "rating", "label": "Reviewscore (bv. 9,8/10)" },
    { "type": "text", "id": "review_count", "label": "Aantal reviews (bv. 607+)" },
    { "type": "text", "id": "kvk", "label": "KVK-nummer" },
    { "type": "text", "id": "btw", "label": "BTW-nummer" }
  ]
}
{% endschema %}
