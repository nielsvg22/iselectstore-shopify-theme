<footer class="siteFooter"><div class="wrap">
  <div class="footer">
    <div class="footerBrand">
      <a class="logo footerLogo" href="{{ routes.root_url }}">
        {% render 'brand-logo', variant: 'white' %}
      </a>
      {% assign brand_text_default = 'footer.brand_text' | t %}
      <p class="footerTagline">{{ section.settings.brand_text | default: brand_text_default }}</p>
      {% if section.settings.show_bestbuyphone_logo %}
        <div class="footerFormerly">
          <span>{{ 'footer.formerly' | t }}</span>
          <img src="{{ 'bestbuyphone-logo-temp.png' | asset_url }}" width="149" height="44" alt="{{ 'header.formerly' | t }}" loading="lazy" decoding="async">
        </div>
      {% endif %}
      <div class="socialRow">
        {% if section.settings.whatsapp != blank %}<a class="socialIc" href="https://wa.me/{{ section.settings.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.9 14.3c-.2.6-1.2 1.2-1.7 1.3-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.5-3.9-4.6-4.1-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.9 1.4 1.9 2.3 1.3 1.1 2.4 1.5 2.7 1.6.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.8.8.3.1.5.2.5.3.1.2.1.6-.1 1.2z"/></svg></a>{% endif %}
        {% if settings.social_instagram_link != blank %}<a class="socialIc" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>{% endif %}
        {% if settings.social_facebook_link != blank %}<a class="socialIc" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5H16l.4-3H13.5V8.4c0-.9.2-1.5 1.5-1.5H16.5V4.2C16.2 4.1 15.2 4 14 4c-2.4 0-4 1.5-4 4.1v2.4H7.5v3H10V21h3.5z"/></svg></a>{% endif %}
      </div>
    </div>

    <div>
      <h4>{{ 'footer.headings.iphones' | t }}</h4>
      <a href="{{ section.settings.shop_collection.url | default: routes.all_products_collection_url }}">{{ 'footer.links.stock' | t }}</a>
      {% if pages['originele-iphone'] %}<a href="{{ pages['originele-iphone'].url }}">{{ 'footer.links.original_iphone' | t }}</a>{% endif %}
      <a class="js-tradein-trigger" href="#">{{ 'footer.links.trade_in' | t }}</a>
      <a class="js-tradein-trigger" href="#">{{ 'footer.links.value_estimate' | t }}</a>
      {% if pages['verkoop-aanmelden'] %}<a href="{{ pages['verkoop-aanmelden'].url }}">{{ 'footer.links.sell_declaration' | t }}</a>{% endif %}
    </div>

    <div>
      <h4>{{ 'footer.headings.information' | t }}</h4>
      <a href="{{ routes.root_url }}">{{ 'footer.links.homepage' | t }}</a>
      {% if pages['over-ons'] %}<a href="{{ pages['over-ons'].url }}">{{ 'footer.links.our_story' | t }}</a>{% endif %}
      {% if pages.contact %}<a href="{{ pages.contact.url }}">{{ 'header.nav.contact' | t }}</a>{% endif %}
      {% if pages.faq %}<a href="{{ pages.faq.url }}">{{ 'footer.links.faq' | t }}</a>{% endif %}
      {% comment %}
        Klachtenprocedure en (voorlopig) Algemene voorwaarden zijn losse
        Pagina's met dit exacte handle, niet Shopify's ingebouwde policy-types
        (die hieronder via shop.policies komen: privacy/retour/verzending).
        Pas zichtbaar zodra de pagina in de Shopify-admin bestaat — geen dode
        link ervoor. Als er ooit ook een "Verkoopvoorwaarden"-policy wordt
        ingevuld, toont shop.policies die apart — check dan of dit niet
        dubbelop wordt met de pagina hieronder.
      {% endcomment %}
      {% if pages.klachtenprocedure %}<a href="{{ pages.klachtenprocedure.url }}">{{ 'footer.links.complaints' | t }}</a>{% endif %}
      {% if pages['algemene-voorwaarden'] %}<a href="{{ pages['algemene-voorwaarden'].url }}">{{ 'footer.links.terms' | t }}</a>{% endif %}
      {% for policy in shop.policies %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endfor %}
    </div>

    <div>
      <h4>{{ 'footer.headings.contact' | t }}</h4>
      <p>{{ section.settings.phone }}</p>
      <p>{{ shop.email }}</p>
      <p>{{ section.settings.address }}</p>
    </div>
  </div>

  {% comment %}
    Voorraadmelding i.p.v. een generieke nieuwsbrief: bezoeker kiest een
    model + opslag (geen productpagina om de identiteit van af te leiden,
    dus de modellenlijst komt live uit /api/inventory/models zodat de
    waarde exact overeenkomt met wat resolveProductIdentity() later
    gebruikt — zie INVENTORY_NOTIFICATIONS.md in de backend-repo). Zelfde
    backend-endpoint (/api/inventory/subscribe) en foutmeldingen
    (themeStrings.inventoryErrors) als het bestaande formulier op
    uitverkochte productpagina's (snippets/inventory-notification-form.liquid).
  {% endcomment %}
  {% assign wa_backend = settings.stock_notify_backend_url | default: 'https://ucwekluofewm5m92pdptoxbh.85.190.105.138.sslip.io' %}
  <div class="newsletter" data-footer-notify data-backend="{{ wa_backend | escape }}">
    <div><b>{{ 'footer.newsletter.title' | t }}</b><p>{{ 'footer.newsletter.subtext' | t }}</p></div>
    <form class="newsletterForm" data-footer-notify-form>
      <select class="footerNotifySelect" name="model" required aria-label="{{ 'footer.newsletter.model_placeholder' | t }}" data-footer-notify-model disabled>
        <option value="">{{ 'footer.newsletter.model_loading' | t }}</option>
      </select>
      <select class="footerNotifySelect" name="storage" aria-label="{{ 'footer.newsletter.storage_placeholder' | t }}" data-footer-notify-storage>
        <option value="">{{ 'footer.newsletter.storage_placeholder' | t }}</option>
        <option value="8GB">8 GB</option>
        <option value="16GB">16 GB</option>
        <option value="32GB">32 GB</option>
        <option value="64GB">64 GB</option>
        <option value="128GB">128 GB</option>
        <option value="256GB">256 GB</option>
        <option value="512GB">512 GB</option>
        <option value="1TB">1 TB</option>
      </select>
      <input type="email" name="email" placeholder="{{ 'footer.newsletter.placeholder' | t }}" required autocomplete="email" data-footer-notify-email>
      <button class="btn primary" type="submit" data-footer-notify-submit>{{ 'footer.newsletter.cta' | t }}</button>
    </form>
    <p class="newsletterMsg" data-footer-notify-msg role="status" hidden></p>
  </div>

  <script>
    (function () {
      var root = document.querySelector('[data-footer-notify]');
      if (!root) return;
      var backend = root.dataset.backend;
      var form = root.querySelector('[data-footer-notify-form]');
      var modelSelect = root.querySelector('[data-footer-notify-model]');
      var storageSelect = root.querySelector('[data-footer-notify-storage]');
      var emailInput = root.querySelector('[data-footer-notify-email]');
      var submitBtn = root.querySelector('[data-footer-notify-submit]');
      var msg = root.querySelector('[data-footer-notify-msg]');

      var loadingLabel = {{ 'footer.newsletter.loading' | t | json }};
      var submitLabel = {{ 'footer.newsletter.cta' | t | json }};
      var thanksText = {{ 'footer.newsletter.thanks' | t | json }};
      var modelLoadingText = {{ 'footer.newsletter.model_loading' | t | json }};
      var modelErrorText = {{ 'footer.newsletter.model_error' | t | json }};
      var modelPlaceholder = {{ 'footer.newsletter.model_placeholder' | t | json }};
      var genericError = {{ 'inventory_notify.errors.generic' | t | json }};

      function codeMessage(code) {
        var strings = (window.themeStrings && window.themeStrings.inventoryErrors) || {};
        return (code && strings[code]) || null;
      }

      function loadModels(attemptsLeft) {
        fetch(backend.replace(/\/$/, '') + '/api/inventory/models')
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (!data || data.ok !== true || !Array.isArray(data.models) || !data.models.length) throw new Error('empty');
            var groups = {};
            var order = [];
            data.models.forEach(function (pair) {
              if (!groups[pair.productType]) { groups[pair.productType] = []; order.push(pair.productType); }
              groups[pair.productType].push(pair.model);
            });
            var html = '<option value="">' + modelPlaceholder + '</option>';
            order.forEach(function (type) {
              html += '<optgroup label="' + type.replace(/"/g, '&quot;') + '">';
              groups[type].forEach(function (model) {
                var safe = model.replace(/"/g, '&quot;');
                html += '<option value="' + safe + '" data-type="' + type.replace(/"/g, '&quot;') + '">' + safe + '</option>';
              });
              html += '</optgroup>';
            });
            modelSelect.innerHTML = html;
            modelSelect.disabled = false;
          })
          .catch(function () {
            // A transient network hiccup shouldn't permanently strand the
            // visitor on "Modellen laden…" — retry a couple of times, then
            // fall back to a clickable retry instead of a dead-looking state.
            if (attemptsLeft > 0) {
              setTimeout(function () { loadModels(attemptsLeft - 1); }, 1500);
              return;
            }
            modelSelect.innerHTML = '<option value="">' + modelErrorText + '</option>';
            modelSelect.disabled = false;
            modelSelect.dataset.retry = '1';
          });
      }
      loadModels(2);

      modelSelect.addEventListener('mousedown', function () {
        if (modelSelect.dataset.retry === '1') {
          delete modelSelect.dataset.retry;
          modelSelect.disabled = true;
          modelSelect.innerHTML = '<option value="">' + modelLoadingText + '</option>';
          loadModels(2);
        }
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var modelOption = modelSelect.options[modelSelect.selectedIndex];
        var productType = modelOption ? modelOption.dataset.type : '';
        var model = modelSelect.value;
        var storage = storageSelect.value;
        if (!productType || !model) return;

        submitBtn.disabled = true;
        submitBtn.textContent = loadingLabel;
        msg.hidden = true;
        msg.classList.remove('is-error', 'is-info');

        fetch(backend.replace(/\/$/, '') + '/api/inventory/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value, productType: productType, model: model, storage: storage })
        })
          .then(function (r) {
            return r.json().catch(function () { return {}; }).then(function (data) {
              if (!r.ok || data.ok !== true) throw new Error(codeMessage(data.code) || data.error || '');
              return data;
            });
          })
          .then(function (data) {
            var code = data.code;
            msg.hidden = false;
            if (code && code !== 'ok') {
              msg.classList.add('is-info');
              msg.textContent = codeMessage(code) || thanksText;
            } else {
              msg.textContent = thanksText;
            }
            form.reset();
            modelSelect.selectedIndex = 0;
            storageSelect.selectedIndex = 0;
          })
          .catch(function (err) {
            msg.hidden = false;
            msg.classList.add('is-error');
            msg.textContent = (err && err.message) || genericError;
          })
          .then(function () {
            submitBtn.disabled = false;
            submitBtn.textContent = submitLabel;
          });
      });
    })();
  </script>

  <div class="footerBadges">
    <span>★★★★★ {{ section.settings.rating | default: "9,8/10" }} {{ 'footer.badges.reviews_suffix' | t }}</span>
    <span>{{ section.settings.review_count | default: "607+" }} {{ 'footer.badges.reviews_count_suffix' | t }}</span>
    {% if section.settings.kvk %}<span>{{ 'footer.badges.kvk' | t }} {{ section.settings.kvk }}</span>{% endif %}
    {% if section.settings.btw %}<span>{{ 'footer.badges.btw' | t }} {{ section.settings.btw }}</span>{% endif %}
  </div>

  {% if shop.enabled_payment_types.size > 0 %}
    {% comment %}
      Gebruikt Shopify's eigen payment_type_svg_tag i.p.v. losse logo-afbeeldingen,
      zodat deze rij altijd exact overeenkomt met wat er daadwerkelijk aanstaat bij
      Instellingen → Betalingen — nooit een methode tonen die niet geaccepteerd wordt.
    {% endcomment %}
    <div class="paymentIcons">
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag: class: 'paymentIcon' }}
      {% endfor %}
    </div>
  {% endif %}

  <div class="finePrint">Copyright © {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
  <img class="footerGiantMark" src="{{ 'brand-mark-coral.svg' | asset_url }}" width="400" height="410" alt="" aria-hidden="true" loading="lazy">
</div></footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "collection", "id": "shop_collection", "label": "Voorraad-collectie" },
    { "type": "text", "id": "brand_text", "label": "Beschrijving onder logo" },
    {
      "type": "checkbox",
      "id": "show_bestbuyphone_logo",
      "label": "Toon 'voorheen BestBuyPhone'-logo in de footer",
      "info": "Tijdelijk, zodat bezoekers herkennen dat iSelectStore de nieuwe naam van BestBuyPhone is. Later uitzetten.",
      "default": true
    },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp nummer (bv. 31643295022)" },
    { "type": "text", "id": "phone", "label": "Telefoonnummer" },
    { "type": "text", "id": "address", "label": "Adres" },
    { "type": "text", "id": "rating", "label": "Reviewscore (bv. 9,8/10)" },
    { "type": "text", "id": "review_count", "label": "Aantal reviews (bv. 607+)" },
    { "type": "text", "id": "kvk", "label": "KVK-nummer" },
    { "type": "text", "id": "btw", "label": "BTW-nummer" }
  ]
}
{% endschema %}
