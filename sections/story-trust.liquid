{% assign eyebrow_default = 'story_page.trust.eyebrow' | t %}
{% assign heading_default = 'story_page.trust.heading_default' | t %}
{% assign sub_default = 'story_page.trust.sub_default' | t %}
{% assign reviews_suffix = 'footer.badges.reviews_suffix' | t %}

<section class="stSection stSoft" id="story-trust"><div class="wrap">
  <div class="head reveal">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow | default: eyebrow_default }}</p>
      <h2>{{ section.settings.heading | default: heading_default }}</h2>
      <p class="sub" style="max-width:640px">{{ section.settings.subtext | default: sub_default }}</p>
    </div>
  </div>

  <div class="stTrustCard reveal">
    <div class="stScore">
      <span class="stStars" aria-hidden="true">★★★★★</span>
      <b>{{ section.settings.rating | default: '9,8/10' }}</b>
      <span class="stScoreMeta">{{ section.settings.review_count | default: '607' }} {{ reviews_suffix }}</span>
    </div>

    <div class="stProofs">
      {% for block in section.blocks %}
        {% assign proof_title_key = 'story_page.trust.items.' | append: forloop.index | append: '.title' %}
        {% assign proof_text_key = 'story_page.trust.items.' | append: forloop.index | append: '.text' %}
        {% assign proof_title_default = proof_title_key | t %}
        {% assign proof_text_default = proof_text_key | t %}
        {% if proof_title_default contains 'translation missing' %}{% assign proof_title_default = '' %}{% endif %}
        {% if proof_text_default contains 'translation missing' %}{% assign proof_text_default = '' %}{% endif %}
        {% assign proof_title = block.settings.title | default: proof_title_default %}
        {% assign proof_text = block.settings.text | default: proof_text_default %}
        {% if proof_title != blank %}
          <div class="stProof" {{ block.shopify_attributes }}>
            <span class="stProofIcon" aria-hidden="true">
              {% if block.settings.icon != blank %}
                {{ block.settings.icon }}
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path><path d="M9 12l2 2 4-4"></path></svg>
              {% endif %}
            </span>
            <div>
              {% if block.settings.link != blank %}
                <a class="stProofTitle" href="{{ block.settings.link }}">{{ proof_title }}</a>
              {% else %}
                <b class="stProofTitle">{{ proof_title }}</b>
              {% endif %}
              {% if proof_text != blank %}<span>{{ proof_text }}</span>{% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div></section>

{% schema %}
{
  "name": "Verhaal-bewijs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "subtext", "label": "Introregel" },
    { "type": "text", "id": "rating", "label": "Reviewscore (bv. 9,8/10)" },
    { "type": "text", "id": "review_count", "label": "Aantal reviews (bv. 607)" }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Bewijspunt",
      "settings": [
        { "type": "html", "id": "icon", "label": "Icoon (SVG)" },
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "textarea", "id": "text", "label": "Tekst" },
        { "type": "url", "id": "link", "label": "Link (optioneel)" }
      ]
    }
  ],
  "presets": [{ "name": "Verhaal-bewijs" }]
}
{% endschema %}
