{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer></script>
<script src="{{ 'collection-stock-order.js' | asset_url }}" defer></script>
<section class="shopHero collectionHero"><div class="wrap">
  <div class="breadcrumb"><a href="{{ routes.root_url }}">{{ 'collection.breadcrumb_home' | t }}</a><span aria-hidden="true">/</span><span>{{ collection.title | escape }}</span></div>
  <p class="eyebrow">{{ 'collection.eyebrow' | t }}</p>
  <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}{{ 'collection.default_title' | t }}{% endif %}</h1>
</div></section>
{% assign bc_home = 'collection.breadcrumb_home' | t %}
{% render 'breadcrumb-jsonld', name_1: bc_home, url_1: routes.root_url, name_2: collection.title, url_2: collection.url %}
{% liquid
  assign current_sort = collection.sort_by | default: 'created-descending'
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
%}
{% paginate collection.products by 24 %}
<section class="collectionListing"><div class="wrap">
  <div class="shopLayout collectionLayout">
    <aside class="filterSidebar collectionFilters" id="filterSidebar" aria-label="{{ 'collection.filters_aria' | t }}">
      <button class="filterCloseBtn" id="filterClose" type="button">{{ 'collection.filters_close' | t }}</button>
      <div class="collectionFilterHeading"><h2>{{ 'collection.filters_heading' | t }}</h2>{% if active_count > 0 %}<a href="{{ collection.url }}?sort_by={{ current_sort | url_encode }}{% if collection.current_type %}&amp;q={{ collection.current_type | url_encode }}{% elsif collection.current_vendor %}&amp;q={{ collection.current_vendor | url_encode }}{% endif %}">{{ 'collection.filters_clear_all' | t }}</a>{% endif %}</div>
      <form action="{{ collection.url }}" method="get" data-collection-filters>
        <input type="hidden" name="sort_by" value="{{ current_sort | escape }}">
        {% if collection.current_type %}<input type="hidden" name="q" value="{{ collection.current_type | escape }}">{% elsif collection.current_vendor %}<input type="hidden" name="q" value="{{ collection.current_vendor | escape }}">{% endif %}
        {% for filter in collection.filters %}
          {% capture localized_filter_label %}{% render 'collection-filter-label', filter: filter %}{% endcapture %}{% assign localized_filter_label = localized_filter_label | strip %}
          <details class="filterGroup collectionFilterGroup" open>
            <summary>{{ localized_filter_label }}<span aria-hidden="true">+</span></summary>
            <div class="collectionFilterOptions">
              {% case filter.type %}
                {% when 'list', 'boolean' %}
                  {% for value in filter.values %}
                    <label class="checkRow">
                      <input type="checkbox" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}" {% if value.active %}checked{% elsif value.count == 0 %}disabled{% endif %}>
                      <span>{% if value.param_name == 'filter.v.availability' %}{% if value.value == '1' %}{{ 'product_card.in_stock' | t }}{% else %}{{ 'collection.filter_unavailable' | t }}{% endif %}{% else %}{% render 'product-spec-text', value: value.label %}{% endif %}</span><span class="cnt">{{ value.count }}</span>
                    </label>
                  {% endfor %}
                {% when 'price_range' %}
                  <div class="collectionPriceRange">
                    <label>{{ 'collection.price_from' | t }} ({{ cart.currency.iso_code | default: shop.currency }})<input type="number" inputmode="decimal" step="0.01" min="0" name="{{ filter.min_value.param_name | escape }}" placeholder="0" {% if filter.min_value.value != blank %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label>
                    <label>{{ 'collection.price_to' | t }} ({{ cart.currency.iso_code | default: shop.currency }})<input type="number" inputmode="decimal" step="0.01" min="0" name="{{ filter.max_value.param_name | escape }}" placeholder="{{ filter.range_max | divided_by: 100.0 }}" {% if filter.max_value.value != blank %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>
                  </div>
              {% endcase %}
            </div>
          </details>
        {% else %}
          <p class="collectionFilterEmpty">{{ 'collection.filters_empty' | t }}</p>
        {% endfor %}
        {% if collection.filters.size > 0 %}<button class="btn primary collectionApply" type="submit">{{ 'collection.filters_apply' | t }}</button>{% endif %}
      </form>
    </aside>
    <div class="shopMain collectionMain">
      <div class="shopToolbar collectionToolbar">
        <form action="{{ routes.search_url }}" method="get" class="searchRow" role="search">
          <input type="hidden" name="type" value="product">
          <label class="collectionSrOnly" for="CollectionSearch">{{ 'collection.search_placeholder' | t }}</label>
          <span class="searchIcon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 5 5"/></svg></span>
          <input id="CollectionSearch" type="search" name="q" class="shopSearchInput" placeholder="{{ 'collection.search_placeholder' | t }}">
          <button type="submit" class="searchSubmit" aria-label="{{ 'collection.search_aria' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 5 5"/></svg></button>
        </form>
        <p class="collectionMobileCount">{{ 'collection.results_count' | t: count: collection.products_count }}</p>
        <div class="toolbarRow" data-mobile-collection-controls>
          <p class="resultCount">{{ 'collection.results_count' | t: count: collection.products_count }}</p>
          <form action="{{ collection.url }}" method="get" class="collectionSort" data-collection-sort>
            {% render 'collection-filter-values', collection: collection %}
            <label for="CollectionSort" class="collectionSrOnly collectionSortLabel">{{ 'collection.sort_label' | t }}</label>
            <select id="CollectionSort" class="sortSelect" name="sort_by">
              {% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == current_sort %}selected{% endif %}>{% if option.value == 'created-descending' %}{{ 'collection.stock_order.newest' | t }}{% else %}{{ option.name | escape }}{% endif %}</option>{% endfor %}
            </select>
            <button class="collectionSortSubmit clearAllBtn" type="submit">{{ 'collection.sort_submit' | t }}</button>
          </form>
          <button class="filterToggle" id="filterToggle" type="button" aria-controls="filterSidebar" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M8 12h8M11 18h2"/></svg>{{ 'collection.filters_toggle' | t }}{% if active_count > 0 %} <span class="collectionFilterCount">{{ active_count }}</span>{% endif %}</button>
        </div>
      </div>
      {% if active_count > 0 %}
        <nav class="activeFilters" aria-label="{{ 'collection.active_filters' | t }}">
          {% for filter in collection.filters %}
          {% capture localized_filter_label %}{% render 'collection-filter-label', filter: filter %}{% endcapture %}{% assign localized_filter_label = localized_filter_label | strip %}
            {% for value in filter.active_values %}
              {% capture localized_filter_value %}{% if value.param_name == 'filter.v.availability' %}{% if value.value == '1' %}{{ 'product_card.in_stock' | t }}{% else %}{{ 'collection.filter_unavailable' | t }}{% endif %}{% else %}{% render 'product-spec-text', value: value.label %}{% endif %}{% endcapture %}{% assign localized_filter_value = localized_filter_value | strip %}
              <a class="filterChip" href="{{ value.url_to_remove }}" aria-label="{{ 'collection.remove_filter' | t: label: localized_filter_label, value: localized_filter_value | escape }}">{{ localized_filter_label }}: {{ localized_filter_value }} <span aria-hidden="true">×</span></a>
            {% endfor %}
            {% if filter.type == 'price_range' %}{% if filter.min_value.value != blank or filter.max_value.value != blank %}<a class="filterChip" href="{{ filter.url_to_remove }}">{{ localized_filter_label }}: {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} <span aria-hidden="true">×</span></a>{% endif %}{% endif %}
          {% endfor %}
          <a class="clearFiltersLink" href="{{ collection.url }}?sort_by={{ current_sort | url_encode }}{% if collection.current_type %}&amp;q={{ collection.current_type | url_encode }}{% elsif collection.current_vendor %}&amp;q={{ collection.current_vendor | url_encode }}{% endif %}">{{ 'collection.filters_clear_all' | t }}</a>
        </nav>
      {% endif %}
      <div data-stock-results data-section-id="{{ section.id }}" data-total="{{ collection.products_count }}" data-page="{{ paginate.current_page }}" data-page-size="24" data-sort="{{ current_sort }}">
      <p class="stockOrderStatus" role="status" hidden data-stock-status data-loading="{{ 'collection.stock_order.loading' | t | escape }}" data-error="{{ 'collection.stock_order.error' | t | escape }}"></p>
      {% if collection.products.size == 0 %}
        <div class="noResults"><h2>{{ 'collection.no_results_title' | t }}</h2><p>{{ 'collection.no_results' | t }}</p>{% if active_count > 0 %}<a class="btn" href="{{ collection.url }}">{{ 'collection.filters_clear_all' | t }}</a>{% endif %}</div>
      {% else %}
        <div class="products shopProductsGrid collectionGrid" data-collection-grid>
          {% for product in collection.products %}
            {% render 'product-card', product: product, index: forloop.index0, collection_card: true %}
            {% if forloop.index == 3 and section.settings.trade_enabled != false %}{% render 'collection-trade-in', settings: section.settings, section_id: section.id %}{% endif %}
          {% endfor %}
          {% if collection.products.size == 2 and section.settings.trade_enabled != false %}{% render 'collection-trade-in', settings: section.settings, section_id: section.id %}{% endif %}
        </div>
        <script type="application/ld+json">{"@context":"https://schema.org","@type":"ItemList","itemListElement":[{% for product in collection.products %}{% unless forloop.first %},{% endunless %}{"@type":"ListItem","position":{{ paginate.current_offset | plus: forloop.index }},"url":{{ shop.url | append: product.url | json }}}{% endfor %}]}</script>
      {% endif %}
      {% if paginate.pages > 1 %}
        <nav class="collectionPagination" aria-label="{{ 'collection.stock_order.pagination' | t }}">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="{{ 'collection.previous_page' | t }}">←</a>{% endif %}
          {% for part in paginate.parts %}{% assign part_number = part.title | plus: 0 %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% elsif part_number == paginate.current_page %}<span aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}{% endfor %}
          {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="{{ 'collection.next_page' | t }}">→</a>{% endif %}
        </nav>
      {% endif %}
      </div>
    </div>
  </div>
</div></section>
{% endpaginate %}
<noscript><style>@media(max-width:900px){.collectionFilters{position:static;transform:none}.collectionFilters .filterCloseBtn,.collectionMain .filterToggle{display:none}.collectionToolbar>.toolbarRow{position:static;display:block}.collectionSort{flex-wrap:wrap}.collectionSortLabel{display:none}}.collectionTrade .js-tradein-trigger{display:none}</style></noscript>
{% schema %}
{
  "name": "Collectie",
  "settings": [
    {"type":"header","content":"Inruilbanner na eerste productrij"},
    {"type":"checkbox","id":"trade_enabled","label":"Inruilbanner op desktop tonen","default":true},
    {"type":"text","id":"trade_title","label":"Titel","default":"Ruil je oude iPhone in. Bespaar op je volgende."},
    {"type":"textarea","id":"trade_description","label":"Beschrijving","default":"Geef je huidige iPhone een tweede leven en ontdek de mogelijkheden om voordeliger te upgraden."},
    {"type":"image_picker","id":"trade_image","label":"Afbeelding"},
    {"type":"text","id":"trade_cta","label":"Knoptekst","default":"Ontdek de inruilmogelijkheden"},
    {"type":"url","id":"trade_url","label":"Bestemming","info":"Leeg: bestaande inruilpagina indien aanwezig, anders de bestaande inruilmodule."}
  ]
}
{% endschema %}
