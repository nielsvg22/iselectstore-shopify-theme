<section class="shopHero"><div class="wrap">
  <div class="breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="color:#fff">{{ collection.title }}</span></div>
  <p class="eyebrow">Volledige voorraad</p>
  <h1>{{ collection.title | default: "Alle producten" }}</h1>
  <p>{{ collection.description | default: "Elk toestel is uniek en persoonlijk gecontroleerd. Filter op categorie, batterijconditie, opslag en prijs om precies te vinden wat je zoekt." }}</p>
</div></section>

{% paginate collection.products by 24 %}
<section style="padding-top:36px"><div class="wrap">
  <div class="shopLayout">
    <aside class="filterSidebar" id="filterSidebar">
      <button class="filterCloseBtn" id="filterClose" type="button">✕ Sluiten</button>
      {% for filter in collection.filters %}
        <div class="filterGroup">
          <h4>{{ filter.label }}</h4>
          {% if filter.type == 'list' %}
            {% for value in filter.values %}
              <label class="checkRow">
                <input type="checkbox" onchange="window.location.href='{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}'" {% if value.active %}checked{% endif %}>
                {{ value.label }}<span class="cnt">{{ value.count }}</span>
              </label>
            {% endfor %}
          {% elsif filter.type == 'price_range' %}
            <div class="rangeRow">
              <form>
                <input type="number" name="{{ filter.min_value.param_name }}" placeholder="Van €" value="{{ filter.min_value.value }}" style="width:47%;display:inline-block;padding:8px;border-radius:8px;border:1px solid var(--line)">
                <input type="number" name="{{ filter.max_value.param_name }}" placeholder="Tot €" value="{{ filter.max_value.value }}" style="width:47%;display:inline-block;padding:8px;border-radius:8px;border:1px solid var(--line)">
                <button class="clearAllBtn" type="submit" style="margin-top:8px">Toepassen</button>
              </form>
            </div>
          {% endif %}
        </div>
      {% endfor %}
      {% if collection.current_vendor or collection.current_type %}
        <a class="clearAllBtn" href="{{ collection.url }}">Wis alle filters</a>
      {% endif %}
    </aside>

    <div class="shopMain">
      <div class="shopToolbar">
        <form action="{{ collection.url }}" method="get" class="searchRow">
          <span class="searchIcon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </span>
          <input type="search" name="q" class="shopSearchInput" placeholder="Zoek een toestel…" value="{{ search.terms }}">
          <button type="submit" class="searchSubmit" aria-label="Zoeken">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
        </form>
        <div class="toolbarRow">
          <select class="sortSelect" onchange="window.location.href=this.value">
            <option value="{{ collection.url }}?sort_by=created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Sorteer: Nieuwste</option>
            <option value="{{ collection.url }}?sort_by=price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Prijs laag - hoog</option>
            <option value="{{ collection.url }}?sort_by=price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Prijs hoog - laag</option>
          </select>
          <button class="filterToggle" id="filterToggle" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="8" y1="12" x2="16" y2="12"></line><line x1="11" y1="18" x2="13" y2="18"></line></svg>
            Filters
          </button>
          <span class="resultCount">{{ collection.products.size }} producten</span>
        </div>
      </div>

      {% if collection.products.size == 0 %}
        <p class="noResults">Geen toestellen gevonden met deze filters.</p>
      {% else %}
        {% comment %} Verkocht/uitverkocht (voorraad 0) altijd onderaan, ongeacht de gekozen sortering. {% endcomment %}
        {% assign available_products = collection.products | where: "available", true %}
        {% assign sold_out_products = collection.products | where: "available", false %}
        {% assign sorted_products = available_products | concat: sold_out_products %}
        <div class="products shopProductsGrid">
          {% for product in sorted_products %}
            {% render 'product-card', product: product, index: forloop.index0 %}
          {% endfor %}
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <div class="snapdots" style="display:flex;margin-top:32px">
          {% for part in paginate.parts %}
            {% if part.is_link %}<a class="link" href="{{ part.url }}">{{ part.title }}</a>{% else %}<b style="color:var(--navy)">{{ part.title }}</b>{% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div></section>
{% endpaginate %}

{% schema %}
{ "name": "Collectie" }
{% endschema %}
