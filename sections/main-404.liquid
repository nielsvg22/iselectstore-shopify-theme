<section class="hero"><div class="heroIn" style="grid-template-columns:1fr;text-align:center">
  <div>
    <div class="eye">{{ 'errors.404.eyebrow' | t }}</div>
    <h1>{{ 'errors.404.heading' | t }}</h1>
    <p class="lead" style="margin:auto">{{ 'errors.404.lead_before' | t }} <a href="{{ routes.root_url }}" style="color:var(--coral-ink);text-decoration:underline">{{ 'errors.404.home_link' | t }}</a> {{ 'errors.404.lead_middle' | t }} <a href="{{ routes.all_products_collection_url }}" style="color:var(--coral-ink);text-decoration:underline">{{ 'errors.404.stock_link' | t }}</a>{{ 'errors.404.lead_after' | t }}</p>
  </div>
</div></section>

{% schema %}
{ "name": "404" }
{% endschema %}
