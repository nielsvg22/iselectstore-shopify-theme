<section class="shopHero"><div class="wrap">
  <div class="breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="color:#fff">Veelgestelde vragen</span></div>
  <p class="eyebrow">Hulp nodig?</p>
  <h1>Veelgestelde vragen</h1>
  {% if pages.contact %}<p>Staat je vraag er niet bij? Neem gerust <a href="{{ pages.contact.url }}" style="color:#fff;text-decoration:underline">persoonlijk contact</a> met ons op.</p>{% endif %}
</div></section>

<section><div class="wrap reveal" style="max-width:820px">
  <div class="accordion" style="border-top:1px solid var(--line)">
    {% for block in section.blocks %}
      <div class="accItem{% if forloop.first %} open{% endif %}" {{ block.shopify_attributes }}>
        <div class="accHead">{{ block.settings.question }}</div>
        <div class="accBody"{% if forloop.first %} style="max-height:400px"{% endif %}><p>{{ block.settings.answer }}</p></div>
      </div>
    {% endfor %}
  </div>
</div></section>

{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {
      "type": "faq",
      "name": "Vraag",
      "settings": [
        { "type": "text", "id": "question", "label": "Vraag" },
        { "type": "richtext", "id": "answer", "label": "Antwoord" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "faq", "settings": { "question": "Zijn jullie iPhones origineel of refurbished?", "answer": "<p>Al onze toestellen zijn originele premium pre-owned Apple-producten: niet refurbished en zonder vervangen onderdelen.</p>" } },
      { "type": "faq", "settings": { "question": "Hoe wordt de batterijconditie bepaald?", "answer": "<p>We meten de batterijcapaciteit met de originele Apple-diagnosetools en vermelden dit percentage duidelijk bij elk product.</p>" } },
      { "type": "faq", "settings": { "question": "Wat houdt de garantie in?", "answer": "<p>Elk toestel wordt geleverd met 6 tot 12 maanden garantie, afhankelijk van het product.</p>" } },
      { "type": "faq", "settings": { "question": "Kan ik mijn oude toestel inruilen?", "answer": "<p>Zeker! Gebruik onze inruil-waardeschatter voor een indicatie van de waarde.</p>" } }
    ]
  },
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
