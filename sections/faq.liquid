<section class="shopHero"><div class="wrap">
  <div class="breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.breadcrumb_home' | t }}</a><span>/</span><span style="color:#fff">{{ 'faq.heading' | t }}</span></div>
  <p class="eyebrow">{{ 'faq.eyebrow' | t }}</p>
  <h1>{{ 'faq.heading' | t }}</h1>
  {% if pages.contact %}<p>{{ 'faq.help_before' | t }} <a href="{{ pages.contact.url }}" style="color:#fff;text-decoration:underline">{{ 'faq.help_link' | t }}</a> {{ 'faq.help_after' | t }}</p>{% endif %}
</div></section>

<section><div class="wrap reveal" style="max-width:820px">
  <div class="accordion" style="border-top:1px solid var(--line)">
    {% for block in section.blocks %}
      {% comment %}
        Vraag/antwoord: als de merchant ze niet heeft ingevuld komt de tekst uit
        de locale (index-gebaseerde keys), zodat Translate & Adapt ze kan vertalen.
      {% endcomment %}
      {% assign question_key = 'faq.items.' | append: forloop.index | append: '.question' %}
      {% assign answer_key = 'faq.items.' | append: forloop.index | append: '.answer' %}
      {% assign question_default = question_key | t %}
      {% assign answer_default = answer_key | t %}
      {% if question_default contains 'translation missing' %}{% assign question_default = '' %}{% endif %}
      {% if answer_default contains 'translation missing' %}{% assign answer_default = '' %}{% endif %}
      <div class="accItem{% if forloop.first %} open{% endif %}" {{ block.shopify_attributes }}>
        <div class="accHead">{{ block.settings.question | default: question_default }}</div>
        <div class="accBody"{% if forloop.first %} style="max-height:400px"{% endif %}><p>{{ block.settings.answer | default: answer_default }}</p></div>
      </div>
    {% endfor %}
  </div>
</div></section>

{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {
      "type": "faq",
      "name": "Vraag",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Vraag"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Antwoord"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "faq" },
      { "type": "faq" },
      { "type": "faq" },
      { "type": "faq" }
    ]
  }
}
{% endschema %}
