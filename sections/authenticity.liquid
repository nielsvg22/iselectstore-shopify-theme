{% assign hero_heading_default = 'authenticity.hero_heading_default' | t %}
<section class="stHero"><div class="wrap stHeroIn">
  <div class="stHeroCopy">
    <p class="eyebrow">{{ 'authenticity.hero_eyebrow' | t }}</p>
    <h1>{{ section.settings.heading | default: hero_heading_default }}</h1>
    <p class="lead">{{ section.settings.subtext }}</p>

    <div class="ctas">
      {% if section.settings.cta_primary_label != blank %}
        <a class="btn primary" href="{{ section.settings.cta_primary_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_primary_label }}</a>
      {% endif %}
      {% if section.settings.cta_secondary_label != blank %}
        <a class="btn" href="{{ section.settings.cta_secondary_link | default: '#story-cta' }}">{{ section.settings.cta_secondary_label }}</a>
      {% endif %}
    </div>

    <div class="authUsps">
      <span>{% render 'icon-mark', size: 16 %}{{ 'authenticity.usp_original' | t }}</span>
      <span class="authUspDivider" aria-hidden="true"></span>
      <span>{% render 'icon-mark', size: 16 %}{{ 'authenticity.usp_battery' | t }}</span>
      <span class="authUspDivider" aria-hidden="true"></span>
      <span>{% render 'icon-mark', size: 16 %}{{ 'authenticity.usp_warranty' | t }}</span>
    </div>
  </div>

  {% if section.settings.image != blank %}
    <div class="stHeroArt stHeroArt--img">
      <img
        src="{{ section.settings.image | image_url: width: 900 }}"
        srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w"
        sizes="(max-width: 899px) 78vw, 440px"
        width="900" height="900"
        alt="{{ section.settings.image.alt | default: shop.name | escape }}"
        loading="eager">
    </div>
  {% else %}
    <div class="stHeroArt" aria-hidden="true">
      <div class="stRings">
        <span class="stRing r1"></span>
        <span class="stRing r2"></span>
        <span class="stRing r3"></span>
        <span class="stOrbitDot d1"></span>
        <span class="stOrbitDot d2"></span>
        <span class="stOrbitDot d3 sel"></span>
        <span class="stOrbitDot d4"></span>
        <span class="stOrbitDot d5"></span>
        <span class="stOrbitDot d6"></span>
        <span class="stHeroCore">
          {% render 'icon-mark', class: 'stMark' %}
        </span>
      </div>
    </div>
  {% endif %}
</div></section>

{% assign bc_home = 'general.breadcrumb_home' | t %}
{% assign bc_self = 'header.nav.original_iphone' | t %}
{% render 'breadcrumb-jsonld',
  name_1: bc_home, url_1: routes.root_url,
  name_2: bc_self, url_2: request.path
%}

{% if section.blocks.size > 0 %}
<section><div class="wrap reveal">
  <p class="eyebrow">{{ 'authenticity.eyebrow' | t }}</p>
  <h2 style="margin-bottom:18px">{{ 'authenticity.heading' | t }}</h2>
  <div class="sub" style="max-width:760px;font-size:16px;line-height:1.7;margin-bottom:40px">{{ section.settings.intro }}</div>

  <div class="checklist" style="display:flex;flex-direction:column;gap:18px;max-width:720px">
    {% for block in section.blocks %}
      {% comment %}
        Staptitel/tekst: valt terug op de locale (index-gebaseerd) als de merchant
        ze niet heeft ingevuld — zo zijn ze vertaalbaar via Translate & Adapt.
      {% endcomment %}
      {% assign step_title_key = 'authenticity.steps.' | append: forloop.index | append: '.title' %}
      {% assign step_text_key = 'authenticity.steps.' | append: forloop.index | append: '.text' %}
      {% assign step_title_default = step_title_key | t %}
      {% assign step_text_default = step_text_key | t %}
      {% if step_title_default contains 'translation missing' %}{% assign step_title_default = '' %}{% endif %}
      {% if step_text_default contains 'translation missing' %}{% assign step_text_default = '' %}{% endif %}
      <div class="checkStep" style="display:flex;gap:18px;align-items:flex-start" {{ block.shopify_attributes }}>
        <div class="checkNum" style="width:38px;height:38px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:800;font-size:14px;flex:none">{{ forloop.index }}</div>
        <div><h4 style="margin:0 0 4px;color:var(--navy);font-size:15.5px">{{ block.settings.title | default: step_title_default }}</h4><p style="margin:0;color:var(--muted);font-size:14px;line-height:1.6">{{ block.settings.text | default: step_text_default }}</p></div>
      </div>
    {% endfor %}
  </div>
</div></section>
{% endif %}

{% schema %}
{
  "name": "Authenticiteit",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtekst (hero)"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introtekst"
    },
    { "type": "image_picker", "id": "image", "label": "Hero-afbeelding (optioneel — anders grafisch beeldmerk)" },
    { "type": "text", "id": "cta_primary_label", "label": "Primaire knop-tekst" },
    { "type": "url", "id": "cta_primary_link", "label": "Primaire knop-link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secundaire knop-tekst" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secundaire knop-link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stap",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Tekst"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "step" },
      { "type": "step" },
      { "type": "step" },
      { "type": "step" },
      { "type": "step" }
    ]
  }
}
{% endschema %}
