<section style="padding-top:32px"><div class="wrap">
  <div class="breadcrumb"><a href="{{ routes.root_url }}">{{ 'product_page.breadcrumb_home' | t }}</a><span>/</span><span style="color:var(--navy)">{{ 'cart_page.breadcrumb' | t }}</span></div>
  <h1 style="margin-bottom:32px">{{ 'cart_page.title' | t }}</h1>

  {% if cart.item_count == 0 %}
    <div class="cartEmpty">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 18px;display:block;width:56px;height:56px"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
      <p>{{ 'cart_page.empty' | t }}</p>
      <a class="btn primary" href="{{ routes.all_products_collection_url }}">{{ 'cart_page.empty_cta' | t }}</a>
    </div>
  {% else %}
    {% form 'cart', cart, id: 'cartForm' %}
      <div class="cartLayout">
        <div>
          {% for item in cart.items %}
            <div class="cartItem">
              <a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 200 }}" width="200" height="200" alt="{{ item.title | escape }}"></a>
              <div class="info">
                <h4><a href="{{ item.url }}">{{ item.product.title }}</a></h4>
                <div class="meta">{{ item.variant.title | replace: 'Default Title', '' }}</div>
                <div class="itemPrice">{{ item.final_line_price | money }}</div>
              </div>
              <a class="remove" href="{{ item.url_to_remove }}">{{ 'cart_page.remove' | t }}</a>
            </div>
          {% endfor %}
        </div>

        <aside class="cartSummary">
          <h3>{{ 'cart_page.summary_title' | t }}</h3>
          <div class="sumRow"><span>{{ 'cart_page.subtotal' | t }}</span><b>{{ cart.total_price | money }}</b></div>
          <div class="sumRow"><span>{{ 'cart_page.shipping' | t }}</span><b>{{ 'cart_page.shipping_free' | t }}</b></div>
          <div class="sumRow total"><span>{{ 'cart_page.total' | t }}</span><b>{{ cart.total_price | money }}</b></div>
          <button class="btn primary" type="submit" name="checkout" style="width:100%;margin-top:18px;justify-content:center">{{ 'cart_page.checkout' | t }}</button>
          <a class="link" href="{{ routes.all_products_collection_url }}" style="justify-content:center;margin-top:16px;width:100%">{{ 'cart_page.continue_shopping' | t }}</a>
        </aside>
      </div>
    {% endform %}

    {% comment %}
      "Heb je ook gedacht aan..." upsell: accessoires (product type "Accessoire")
      worden nergens los in de shop getoond, alleen hier als cross-sell zodra er
      een toestel in de winkelwagen zit.
    {% endcomment %}
    {% assign cart_has_device = false %}
    {% assign cart_product_ids = "," %}
    {% for item in cart.items %}
      {% assign cart_product_ids = cart_product_ids | append: item.product_id | append: ',' %}
      {% unless item.product.type == 'Accessoire' %}{% assign cart_has_device = true %}{% endunless %}
    {% endfor %}

    {% if cart_has_device %}
      {% assign upsell_products = collections.all.products | where_exp: "product", "product.type == 'Accessoire'" %}
      {% assign upsell_shown = 0 %}
      {% assign has_any_upsell = false %}
      {% capture upsell_cards %}
        {% for product in upsell_products %}
          {% assign id_token = ',' | append: product.id | append: ',' %}
          {% if cart_product_ids contains id_token %}{% continue %}{% endif %}
          {% assign has_any_upsell = true %}
          {% assign variant = product.selected_or_first_available_variant %}
          {% assign subtitle = product.description | strip_html | truncatewords: 7 %}
          <div class="upsellCard">
            <a href="{{ product.url }}" class="upsellCard__imgWrap">
              {% unless product.available %}<span class="ribbon upsellCard__ribbon">{{ 'cart_page.upsell_sold_out' | t }}</span>{% endunless %}
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}" width="400" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
              {% endif %}
            </a>
            <h4 class="upsellCard__title"><a href="{{ product.url }}">{{ product.title }}</a></h4>
            {% if subtitle != blank %}<p class="upsellCard__sub">{{ subtitle }}</p>{% endif %}
            <div class="upsellCard__row">
              <div class="upsellCard__price">
                <b>{{ product.price | money }}</b>
                {% if product.compare_at_price > product.price %}<span class="old">{{ product.compare_at_price | money }}</span>{% endif %}
              </div>
              <button type="button" class="upsellCard__add" data-upsell-add data-variant-id="{{ variant.id }}" aria-label="{{ 'cart_page.upsell_add_aria' | t }}" {% unless product.available %}disabled{% endunless %}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              </button>
            </div>
          </div>
          {% assign upsell_shown = upsell_shown | plus: 1 %}
          {% if upsell_shown >= 6 %}{% break %}{% endif %}
        {% endfor %}
      {% endcapture %}
      {% if has_any_upsell %}
        <div class="cartUpsell">
          <h3 class="cartUpsell__title">{{ 'cart_page.upsell_title' | t }}</h3>
          <p class="cartUpsell__subtitle">{{ 'cart_page.upsell_subtitle' | t }}</p>
          <div class="cartUpsell__grid">{{ upsell_cards }}</div>
          <a class="add cartUpsell__viewAll" href="{{ routes.all_products_collection_url }}?filter.p.product_type=Accessoire">{{ 'cart_page.upsell_view_all' | t }}</a>
        </div>
      {% endif %}
    {% endif %}
  {% endif %}
</div></section>

<style>
  .cartUpsell { margin-top: 56px; }
  .cartUpsell__title { margin: 0 0 6px; }
  .cartUpsell__subtitle { margin: 0 0 22px; color: var(--muted); font-size: 14.5px; }
  .cartUpsell__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .cartUpsell__viewAll { display: flex; width: 100%; margin-top: 28px; text-decoration: none; }
  .upsellCard { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 14px; display: flex; flex-direction: column; }
  .upsellCard__imgWrap { position: relative; display: block; aspect-ratio: 1; background: var(--ivory); border-radius: 12px; overflow: hidden; margin-bottom: 12px; }
  .upsellCard__imgWrap img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .upsellCard__ribbon { top: 10px; left: 10px; font-size: 10px; padding: 6px 10px; }
  .upsellCard__title { margin: 0 0 4px; font-size: 14.5px; line-height: 1.3; }
  .upsellCard__title a { color: var(--navy); text-decoration: none; }
  .upsellCard__sub { margin: 0 0 12px; color: var(--muted); font-size: 12.5px; line-height: 1.4; flex: 1; }
  .upsellCard__row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .upsellCard__price b { font-size: 16px; color: var(--navy); }
  .upsellCard__price .old { margin-left: 6px; font-size: 12px; color: var(--muted); text-decoration: line-through; }
  .upsellCard__add { flex: none; width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--ivory); color: var(--navy); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background .2s, color .2s; }
  .upsellCard__add svg { width: 18px; height: 18px; }
  .upsellCard__add:hover { background: var(--navy); color: #fff; }
  .upsellCard__add:disabled { opacity: .5; cursor: not-allowed; }
  @media (max-width: 900px) { .cartUpsell__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{ "name": "Winkelwagen" }
{% endschema %}
