<section><div class="wrap reveal">
  <div class="head"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></div>
  <div class="sub" style="max-width:760px;font-size:16px;line-height:1.7">{{ section.settings.text }}</div>
</div></section>

{% schema %}
{
  "name": "Tekstblok",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "richtext", "id": "text", "label": "Tekst" }
  ],
  "presets": [{ "name": "Tekstblok" }]
}
{% endschema %}
