{% comment %}
  Taalkeuze — Shopify's native localization form (Shopify Markets).
  Alleen zichtbaar als de shop meerdere locales heeft ingeschakeld.
{% endcomment %}

{% if shop.enabled_locales.size > 1 %}
  <section class="language-selector" data-section-id="{{ section.id }}">
    <div class="wrap">
      <div class="language-selector__inner">
        {% form 'localization', class: 'language-selector__form' %}
          <input type="hidden" name="return_to" value="{{ request.path }}">
          <label for="LocaleSelector-{{ section.id }}" class="language-selector__label">{{ 'language_selector.label' | t }}</label>
          <select id="LocaleSelector-{{ section.id }}" name="locale_code" class="sortSelect" aria-label="{{ 'language_selector.label' | t }}">
            {% for locale in shop.enabled_locales %}
              <option value="{{ locale.iso_code }}" {% if locale.iso_code == request.locale.iso_code %}selected{% endif %}>
                {{ locale.endonym_name | default: locale.name }}
              </option>
            {% endfor %}
          </select>
          <button type="submit" class="btn" style="padding:10px 18px;font-size:13px;">{{ 'language_selector.button' | t }}</button>
        {% endform %}
      </div>
    </div>
  </section>

  <style>
    .language-selector { padding: 18px 0; }
    .language-selector__inner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .language-selector__label {
      font-size: 14px;
      font-weight: 600;
      color: var(--navy);
    }
    .language-selector__form {
      display: flex;
      align-items: center;
      gap: 10px;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Taalkeuze",
  "presets": [
    { "name": "Taalkeuze" }
  ]
}
{% endschema %}
