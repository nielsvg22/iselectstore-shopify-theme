{% assign current_variant = product.selected_or_first_available_variant %}
{% assign guarantee_page = section.settings.guarantee_page %}
{% assign condition_page = section.settings.condition_page %}

<section style="padding-top:32px;padding-bottom:0"><div class="wrap">
  <div class="breadcrumb">
    <a href="{{ routes.root_url }}">{{ 'product_page.breadcrumb_home' | t }}</a><span>/</span>
    <a href="{{ routes.all_products_collection_url }}">{{ 'product_page.breadcrumb_stock' | t }}</a><span>/</span>
    {% if product.type %}<a href="{{ routes.all_products_collection_url }}?filter.p.product_type={{ product.type | url_encode }}">{{ product.type }}</a><span>/</span>{% endif %}
    <span style="color:var(--navy)">{{ product.title }}</span>
  </div>
</div></section>

{% comment %}
  "Dit toestel" = kenmerken van dit exacte exemplaar (opslag, batterij,
  kleur, SIM/eSIM, conditie, garantie, laadcycli …).
  "Algemene specificaties" = vaste eigenschappen van het model.
  Beide lezen via snippets/spec-row → spec-value (custom → app…-mkt fallback).
{% endcomment %}
{% capture device_rows %}
  {% render 'spec-row', product: product, key: 'storage_gb', label: 'product_page.spec_storage', format: 'storage', types: 'iPhone|iPad|MacBook|iMac|Mac mini' %}
  {% render 'spec-row', product: product, key: 'battery_percentage', label: 'product_page.spec_battery', format: 'percent', types: 'iPhone|iPad|MacBook|Apple Watch' %}
  {% render 'spec-row', product: product, key: 'color', label: 'product_page.field_color' %}
  {% render 'spec-row', product: product, key: 'sim_type', label: 'product_page.field_sim', types: 'iPhone|iPad' %}
  {% render 'spec-row', product: product, key: 'wifi_cellular', label: 'product_page.field_wifi_cellular', types: 'iPad' %}
  {% render 'spec-row', product: product, key: 'condition', label: 'product_page.spec_condition' %}
  {% render 'spec-row', product: product, key: 'warranty_months', label: 'product_page.spec_warranty', format: 'warranty' %}
  {% render 'spec-row', product: product, key: 'cycle_count', label: 'product_page.field_cycles', types: 'MacBook' %}
  {% render 'spec-row', product: product, key: 'keyboard_layout', label: 'product_page.field_keyboard_layout', types: 'MacBook' %}
  {% render 'spec-row', product: product, key: 'box_included', label: 'product_page.field_box', format: 'boolean', types: 'iPhone|iPad|MacBook' %}
  {% render 'spec-row', product: product, key: 'accessories', label: 'product_page.field_accessories', format: 'wide', types: 'iPhone|iPad|MacBook|Mac mini|Apple Watch' %}
  {% render 'spec-row', product: product, key: 'cosmetic_notes', label: 'product_page.field_cosmetic_notes', format: 'wide' %}
  {% render 'spec-row', product: product, key: 'watch_band', label: 'product_page.field_band', types: 'Apple Watch' %}
{% endcapture %}
{% assign device_rows = device_rows | strip %}

{% capture general_rows %}
  {% render 'spec-row', product: product, key: 'model', label: 'product_page.field_model' %}
  {% render 'spec-row', product: product, key: 'generation', label: 'product_page.field_generation', types: 'iPhone|iPad' %}
  {% render 'spec-row', product: product, key: 'screen_size', label: 'product_page.field_screen', types: 'iPad|MacBook|iMac' %}
  {% render 'spec-row', product: product, key: 'model_year', label: 'product_page.field_year', types: 'MacBook|iMac|Mac mini' %}
  {% render 'spec-row', product: product, key: 'chip', label: 'product_page.field_chip', types: 'MacBook|iMac|Mac mini' %}
  {% render 'spec-row', product: product, key: 'cpu_variant', label: 'product_page.field_cpu', types: 'MacBook|Mac mini' %}
  {% render 'spec-row', product: product, key: 'gpu_variant', label: 'product_page.field_gpu', types: 'MacBook|iMac|Mac mini' %}
  {% render 'spec-row', product: product, key: 'ram_gb', label: 'product_page.field_ram', types: 'MacBook|iMac|Mac mini' %}
  {% render 'spec-row', product: product, key: 'apple_pencil_support', label: 'product_page.field_pencil', format: 'boolean', types: 'iPad' %}
  {% render 'spec-row', product: product, key: 'watch_series', label: 'product_page.field_series', types: 'Apple Watch' %}
  {% render 'spec-row', product: product, key: 'watch_case_size', label: 'product_page.field_case_size', types: 'Apple Watch' %}
  {% render 'spec-row', product: product, key: 'watch_material', label: 'product_page.field_material', types: 'Apple Watch' %}
  {% render 'spec-row', product: product, key: 'watch_connectivity', label: 'product_page.field_connectivity', types: 'Apple Watch' %}
  {% render 'spec-row', product: product, key: 'keyboard_included', label: 'product_page.field_keyboard_included', format: 'boolean', types: 'iMac' %}
  {% render 'spec-row', product: product, key: 'mouse_included', label: 'product_page.field_mouse_included', format: 'boolean', types: 'iMac' %}
{% endcapture %}
{% assign general_rows = general_rows | strip %}

{% capture condition_display %}{% render 'spec-value', product: product, key: 'condition' %}{% endcapture %}
{% assign condition_display = condition_display | strip %}

<section style="padding-top:0"><div class="wrap">
  <div class="pdp">
    <div class="gallery">
      <div class="galleryMain">
        {% comment %} Per-product badge_text metafield wint van de algemene sectie-tekst, zodat de
        productpagina hetzelfde label toont als de productkaart op de shop/homepage. {% endcomment %}
        {% assign ribbon_text_default = 'product_page.ribbon_default' | t %}
        {% assign ribbon_text = product.metafields.custom.badge_text | default: section.settings.ribbon_text | default: ribbon_text_default %}
        {% if section.settings.show_ribbon and ribbon_text != blank and product.available %}<span class="ribbon">{{ ribbon_text }}</span>{% endif %}
        <img id="mainImg" src="{{ product.featured_image | image_url: width: 900 }}" width="900" height="900" alt="{{ product.featured_image.alt | default: product.title | escape }}">
      </div>
      {% if product.media.size > 1 %}
        <div class="thumbs">
          {% for media in product.media %}
            <div class="thumb{% if forloop.first %} active{% endif %}" data-img="{{ media | image_url: width: 900 }}">
              <img src="{{ media | image_url: width: 200 }}" width="200" height="200" alt="{{ product.title | escape }} ({{ forloop.index }})">
            </div>
          {% endfor %}
        </div>
      {% endif %}
      {% if section.settings.show_real_photos %}
        <div class="galleryTrust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          <span>{{ 'product_page.real_photos' | t }}</span>
        </div>
      {% endif %}
    </div>

    <div class="pdpInfo">
      <b class="brand">{{ shop.name | default: 'Apple' }}{% if product.type %} · {{ product.type }}{% endif %}</b>
      <h1>{{ product.title }}</h1>
      <div class="pdpRating"><span class="stars">★★★★★</span><span>{% if section.settings.rating != blank %}{{ section.settings.rating }}{% else %}{{ 'product_page.rating_default' | t }}{% endif %}</span></div>

      <div class="pdpPrice">
        <b>{{ current_variant.price | money }}</b>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="old">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
        {% if current_variant.compare_at_price > current_variant.price %}
          {% assign saving = current_variant.compare_at_price | minus: current_variant.price %}
          <span class="pdpSaving">{{ 'product_page.saving_prefix' | t }} {{ saving | money }}</span>
        {% endif %}
      </div>
      <p class="pdpTaxNote">{{ 'product_page.tax_note' | t }}</p>
      {% if current_variant.available == false %}
        <p class="stockNote stockNote--sold">{{ 'products.product.sold_out' | t }}</p>
      {% elsif current_variant.inventory_management and current_variant.inventory_quantity <= 1 %}
        <p class="stockNote">{{ 'product_page.low_stock' | t }}</p>
      {% endif %}

      {% if device_rows != blank %}
        <div class="specs">
          <div class="specsHead">
            <b>{{ 'product_page.device_heading' | t }}</b>
            <span>{{ 'product_page.device_sub' | t }}</span>
          </div>
          {{ device_rows }}
        </div>
      {% endif %}

      {% if section.settings.accessory_1 or section.settings.accessory_2 or section.settings.accessory_3 %}
        <div class="optionGroup">
          <label>{{ 'product_page.accessories_label' | t }}</label>
          <div class="accessories" id="accessoryList">
            {% if section.settings.accessory_1 %}{% render 'accessory-option', accessory: section.settings.accessory_1 %}{% endif %}
            {% if section.settings.accessory_2 %}{% render 'accessory-option', accessory: section.settings.accessory_2 %}{% endif %}
            {% if section.settings.accessory_3 %}{% render 'accessory-option', accessory: section.settings.accessory_3 %}{% endif %}
          </div>
          <div class="accTotal">{{ 'product_page.accessories_total' | t }} <b class="js-total">{{ current_variant.price | money }}</b></div>
        </div>
      {% endif %}

      {% render 'inventory-notification-form', current_variant: current_variant %}

      {% form 'product', product, id: 'productForm' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <div class="buyRow" data-base-price="{{ current_variant.price }}" data-currency="{{ cart.currency.iso_code }}">
          <button class="add" type="submit" id="addToCart" {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}
              {{ 'product_page.add_to_cart' | t }} <span class="js-total-inline">{{ current_variant.price | money }}</span>
            {% else %}
              {{ 'products.product.sold_out' | t }}
            {% endif %}
          </button>
        </div>
      {% endform %}
      <a class="btn js-tradein-trigger" style="width:100%;margin-bottom:26px" href="#">{{ 'product_page.trade_in_cta' | t }}</a>

      <div class="pdpFeatures">
        {% if product.type != blank %}{% assign feature_product_type = product.type %}{% else %}{% assign feature_product_type = 'product_page.apple_product_default' | t %}{% endif %}
        <div class="pdpFeature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l7 4v6c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-4z"/></svg>{{ 'product_page.feature_original' | t: type: feature_product_type }}</div>
        {% capture feature_battery %}{% render 'spec-value', product: product, key: 'battery_percentage' %}{% endcapture %}
        {% assign feature_battery = feature_battery | strip %}
        {% if feature_battery != blank %}<div class="pdpFeature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>{{ 'product_page.feature_battery' | t: percentage: feature_battery }}</div>{% endif %}
        {% capture feature_condition %}{% render 'spec-value', product: product, key: 'condition' %}{% endcapture %}
        {% assign feature_condition = feature_condition | strip %}
        {% if feature_condition != blank %}<div class="pdpFeature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="16" height="8" rx="2"/><path d="M19 10.5h2v3h-2"/></svg>{{ 'product_page.feature_condition' | t: condition: feature_condition }}</div>{% endif %}
        {% capture feature_warranty %}{% render 'spec-value', product: product, key: 'warranty_months' %}{% endcapture %}
        {% assign feature_warranty = feature_warranty | strip %}
        {% if feature_warranty != blank %}<div class="pdpFeature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'product_page.feature_warranty' | t: months: feature_warranty }}</div>{% endif %}
      </div>

      {% assign show_guarantee_link = false %}
      {% if section.settings.show_guarantee_link and guarantee_page != blank %}{% assign show_guarantee_link = true %}{% endif %}
      {% assign show_condition_link = false %}
      {% if section.settings.show_condition_link and condition_page != blank %}{% assign show_condition_link = true %}{% endif %}
      {% if show_guarantee_link or show_condition_link %}
        <div class="pdpLinks">
          {% if show_guarantee_link %}
            <a class="pdpLink" href="{{ guarantee_page.url }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l7 4v6c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-4z"/></svg>
              <span>{{ 'product_page.link_guarantee' | t }}</span>
            </a>
          {% endif %}
          {% if show_condition_link %}
            <a class="pdpLink" href="{{ condition_page.url }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 5-5"/></svg>
              <span>{{ 'product_page.link_condition' | t }}</span>
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% assign condition_text_default = 'product_page.condition_text_default' | t %}
      {% assign guarantee_text_default = 'product_page.guarantee_text_default' | t %}
      {% capture condition_body %}
        {% if condition_display != blank %}<p class="accStrong">{{ condition_display }}</p>{% endif %}
        <p>{{ section.settings.condition_text | default: condition_text_default }}</p>
        {% if section.settings.show_condition_link and condition_page != blank %}
          <a class="accLink" href="{{ condition_page.url }}">{{ 'product_page.condition_link_cta' | t }}</a>
        {% endif %}
      {% endcapture %}
      {% capture guarantee_body %}
        <p>{{ section.settings.guarantee_text | default: guarantee_text_default }}</p>
        {% if section.settings.show_guarantee_link and guarantee_page != blank %}
          <a class="accLink" href="{{ guarantee_page.url }}">{{ 'product_page.guarantee_link_cta' | t }}</a>
        {% endif %}
      {% endcapture %}

      <div class="accordion">
        <div class="accItem open">
          <div class="accHead">{{ 'product_page.accordion_description' | t }}</div>
          <div class="accBody" style="max-height:400px">{{ product.description }}</div>
        </div>
        {% if section.settings.show_general_specs and general_rows != blank %}
        <div class="accItem">
          <div class="accHead">{{ 'product_page.accordion_specs' | t }}</div>
          <div class="accBody">
            <p class="accNote">{{ 'product_page.general_specs_sub' | t }}</p>
            <div class="specs specs--flush">{{ general_rows }}</div>
          </div>
        </div>
        {% endif %}
        <div class="accItem">
          <div class="accHead">{{ 'product_page.accordion_condition' | t }}</div>
          <div class="accBody">{{ condition_body }}</div>
        </div>
        <div class="accItem">
          <div class="accHead">{{ 'product_page.accordion_guarantee' | t }}</div>
          <div class="accBody">{{ guarantee_body }}</div>
        </div>
        <div class="accItem">
          <div class="accHead">{{ 'product_page.accordion_shipping' | t }}</div>
          <div class="accBody"><p>{% if section.settings.shipping_text != blank %}{{ section.settings.shipping_text }}{% else %}{{ 'product_page.shipping_text_default' | t }}{% endif %}</p></div>
        </div>
      </div>
    </div>
  </div>
</div></section>

{% assign related_collection = product.collections.first %}
{% if related_collection %}
  <section style="background:var(--ivory)"><div class="wrap reveal">
    <div class="head"><div><p class="eyebrow">{{ 'product_page.related_eyebrow' | t }}</p><h2>{{ 'product_page.related_heading' | t }}</h2></div><a class="link" href="{{ related_collection.url }}">{{ 'product_page.related_cta' | t }}</a></div>
    <div class="products">
      {% assign shown = 0 %}
      {% for related in related_collection.products %}
        {% if related.id != product.id and related.type != 'Accessoire' and shown < 4 %}
          {% render 'product-card', product: related %}
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div></section>
{% endif %}

<div class="mobileBuy" id="mobileBuy">
  <div class="mbPrice"><b class="js-total">{{ current_variant.price | money }}</b>{% if current_variant.compare_at_price > current_variant.price %}<span>{{ current_variant.compare_at_price | money }}</span>{% endif %}</div>
  <button class="add" id="addToCartMobile" data-form="productForm" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_ribbon", "label": "Toon 'Nieuw binnen!'-ribbon", "default": true },
    { "type": "text", "id": "ribbon_text", "label": "Ribbon-tekst" },
    { "type": "text", "id": "rating", "label": "Reviewtekst onder titel" },
    { "type": "textarea", "id": "shipping_text", "label": "Verzending & service-tekst" },
    { "type": "header", "content": "Informatiepagina's" },
    { "type": "page", "id": "guarantee_page", "label": "Garantiepagina" },
    { "type": "checkbox", "id": "show_guarantee_link", "label": "Link naar garantiepagina tonen", "default": true },
    { "type": "textarea", "id": "guarantee_text", "label": "Garantie-uitleg (accordeon)" },
    { "type": "page", "id": "condition_page", "label": "Conditiepagina" },
    { "type": "checkbox", "id": "show_condition_link", "label": "Link naar conditiepagina tonen", "default": true },
    { "type": "textarea", "id": "condition_text", "label": "Conditie-uitleg (accordeon)" },
    { "type": "header", "content": "Weergave" },
    { "type": "checkbox", "id": "show_general_specs", "label": "Accordeon 'Algemene specificaties' tonen", "default": true },
    { "type": "checkbox", "id": "show_real_photos", "label": "Label 'Echte foto's van dit toestel' tonen", "default": true },
    { "type": "header", "content": "Accessoires" },
    { "type": "product", "id": "accessory_1", "label": "Accessoire 1 (bv. screenprotector)" },
    { "type": "product", "id": "accessory_2", "label": "Accessoire 2 (bv. oplaadkabel)" },
    { "type": "product", "id": "accessory_3", "label": "Accessoire 3 (bv. USB-C adapter)" }
  ]
}
{% endschema %}
