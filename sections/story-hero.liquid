{% comment %}
  Ons verhaal — hero.
  De merk-slogan "SELECTED BY US, READY FOR YOU" staat bewust als literal in
  de markup en komt NIET in de locale-bestanden voor: hij blijft in elke taal
  exact Engels.
{% endcomment %}
{% assign eyebrow_default = 'story_page.hero.eyebrow' | t %}
{% assign heading_default = 'story_page.hero.heading_default' | t %}
{% assign subtext_default = 'story_page.hero.subtext_default' | t %}
{% assign cta_video_default = 'story_page.hero.cta_video' | t %}
{% assign cta_down_default = 'story_page.hero.cta_down' | t %}

{% assign has_bg_video = false %}
{% if section.settings.video_file_url != blank %}{% assign has_bg_video = true %}{% endif %}

{% assign heading_text = section.settings.heading | default: heading_default %}
{% assign heading_html = heading_text | replace: 'iSelectStore', '<span class="stHeroBrand">iSelectStore</span>' %}

{% assign usp_original = 'authenticity.usp_original' | t %}
{% assign usp_battery = 'authenticity.usp_battery' | t %}
{% assign usp_warranty = 'authenticity.usp_warranty' | t %}

<section class="stHero{% if has_bg_video %} stHero--video{% endif %}" id="story-top">
  {% if has_bg_video %}
    <video
      class="stHeroBgVideo"
      src="{{ section.settings.video_file_url }}"
      {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1600 }}"{% endif %}
      autoplay muted loop playsinline
      aria-hidden="true">
    </video>
    <div class="stHeroVideoOverlay" aria-hidden="true"></div>
  {% endif %}
  <div class="wrap stHeroIn">
    <div class="stHeroCopy">
      <p class="eyebrow">{{ section.settings.eyebrow | default: eyebrow_default }}</p>
      <h1>{{ heading_html }}</h1>
      <p class="lead">{{ section.settings.subtext | default: subtext_default }}</p>

      <p class="stSlogan">SELECTED BY US, READY FOR YOU</p>

      <div class="ctas">
        <a class="btn primary" href="#story-video">{{ section.settings.cta_video | default: cta_video_default }}</a>
        <a class="btn" href="#story-intro">{{ section.settings.cta_down | default: cta_down_default }}</a>
      </div>

      {% if has_bg_video %}
        <div class="stHeroUsps">
          <div class="stHeroUsp">
            <span class="stHeroUspIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path><path d="M9 12l2 2 4-4"></path></svg></span>
            <span>{{ usp_original }}</span>
          </div>
          <div class="stHeroUsp">
            <span class="stHeroUspIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="18" height="10" rx="2"></rect><line x1="22" y1="10" x2="22" y2="14"></line></svg></span>
            <span>{{ usp_battery }}</span>
          </div>
          <div class="stHeroUsp">
            <span class="stHeroUspIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8V7l-3-4H6L3 7v1"></path><path d="M3 8l9 5 9-5"></path><path d="M3 8v9a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V8"></path><path d="M12 13v9"></path></svg></span>
            <span>{{ usp_warranty }}</span>
          </div>
        </div>
      {% endif %}
    </div>

    {% unless has_bg_video %}
      {% if section.settings.image != blank %}
        <div class="stHeroArt stHeroArt--img">
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w"
            sizes="(max-width: 899px) 78vw, 440px"
            width="900" height="900"
            alt="{{ section.settings.image.alt | default: shop.name | escape }}"
            loading="eager">
        </div>
      {% else %}
        <div class="stHeroArt" aria-hidden="true">
          <div class="stRings">
            <span class="stRing r1"></span>
            <span class="stRing r2"></span>
            <span class="stRing r3"></span>
            <span class="stOrbitDot d1"></span>
            <span class="stOrbitDot d2"></span>
            <span class="stOrbitDot d3 sel"></span>
            <span class="stOrbitDot d4"></span>
            <span class="stOrbitDot d5"></span>
            <span class="stOrbitDot d6"></span>
            <span class="stHeroCore">
              {% render 'icon-mark', class: 'stMark' %}
            </span>
          </div>
        </div>
      {% endif %}
    {% endunless %}
  </div>
</section>

{% schema %}
{
  "name": "Verhaal-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Titel (H1)" },
    { "type": "textarea", "id": "subtext", "label": "Subtekst" },
    { "type": "text", "id": "cta_video", "label": "Knop: naar video" },
    { "type": "text", "id": "cta_down", "label": "Knop: verder naar beneden" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding (optioneel — anders grafisch beeldmerk)" },
    { "type": "url", "id": "video_file_url", "label": "Video-bestand URL (optioneel)", "info": "Vervangt de afbeelding, speelt gedempt/herhalend af." }
  ]
}
{% endschema %}
