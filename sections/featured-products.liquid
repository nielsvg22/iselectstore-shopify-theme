{% assign limit = section.settings.count | default: 4 %}
{% assign featured_pool = section.settings.collection.products | where: 'available', true | reject: 'type', 'Accessoire' %}
{% assign cat_names = 'iPhone,iPad,MacBook,Apple Watch' | split: ',' %}
{% assign featured_sorted = '' | split: '' %}
{% for round in (0..7) %}
  {% if featured_sorted.size >= limit %}{% break %}{% endif %}
  {% for cat in cat_names %}
    {% if featured_sorted.size >= limit %}{% break %}{% endif %}
    {% assign cat_take = featured_pool | where: 'type', cat | slice: round, 1 %}
    {% assign featured_sorted = featured_sorted | concat: cat_take %}
  {% endfor %}
{% endfor %}
{% if featured_sorted.size > 0 %}
<section id="producten" style="padding-top:6px"><div class="wrap reveal">
  <div class="head">
    <div>
      <p class="eyebrow">{{ 'featured_products.eyebrow' | t }}</p>
      {% assign products_heading_default = 'featured_products.heading_default' | t %}
      <h2>{{ section.settings.heading | default: products_heading_default }}</h2>
      <p class="sub">{{ section.settings.subtext }}</p>
    </div>
    <a class="link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'featured_products.view_shop_cta' | t }}</a>
  </div>

  <div class="tabs" id="catTabs">
    <span class="tab active" data-cat="Alle">{{ 'featured_products.tab_all' | t }}</span>
    {% for cat in cat_names %}
      {% assign visible_category_products = featured_sorted | where: 'type', cat %}
      {% if visible_category_products.size > 0 %}<span class="tab" data-cat="{{ cat | escape }}">{{ cat | escape }}</span>{% endif %}
    {% endfor %}
  </div>

  <div class="products">
    {% for product in featured_sorted limit: limit %}
      {% if product.available %}{% render 'product-card', product: product, index: forloop.index0 %}{% endif %}
    {% endfor %}
  </div>
</div></section>

{% endif %}

{% schema %}
{
  "name": "Uitgelichte producten",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "subtext", "label": "Subtekst" },
    { "type": "collection", "id": "collection", "label": "Collectie om te tonen" },
    { "type": "range", "id": "count", "label": "Aantal producten", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Uitgelichte producten" }]
}
{% endschema %}
