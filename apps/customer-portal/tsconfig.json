{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@shopify/ui-extensions/customer-account.page.render"]
  },
  "include": ["extensions/**/*.ts", "extensions/**/*.tsx", "extensions/**/*.mjs"]
}
