{
  "name": "iselectstore-customer-portal",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "dev": "shopify app dev",
    "build": "shopify app build",
    "bundle": "esbuild extensions/portal/src/Portal.tsx --bundle --format=esm --jsx=automatic --jsx-import-source=preact --outfile=dist/portal.js --minify",
    "bundle:entry": "esbuild extensions/portal-entry/src/Entry.tsx --bundle --format=esm --jsx=automatic --jsx-import-source=preact --outfile=dist/entry.js --minify",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run bundle && npm run bundle:entry && node scripts/browser-smoke.mjs",
    "deploy": "shopify app deploy",
    "build:storefront": "esbuild storefront/Portal.tsx --bundle --format=iife --jsx=automatic --jsx-import-source=preact --outfile=../../assets/storefront-portal.js --minify",
    "typecheck:storefront": "tsc --noEmit -p storefront/tsconfig.json",
    "test:storefront:browser": "npm run build:storefront && node scripts/storefront-browser.mjs",
    "test:native:browser": "node scripts/native-browser.mjs",
    "test:brand:browser": "node scripts/brand-browser.mjs",
    "test:collection:browser": "node scripts/collection-browser.mjs",
    "test:product-card:browser": "node scripts/product-card-browser.mjs",
    "test:homepage:stock": "node scripts/homepage-stock-test.mjs",
    "test:collection:stock": "node scripts/collection-stock-browser.mjs",
    "test:notification:browser": "node scripts/notification-brand-browser.mjs",
    "test:specifications": "node scripts/specification-localization-test.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@shopify/ui-extensions": "2026.7.4",
    "oauth4webapi": "^3.8.8",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@shopify/cli": "^3.89.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "graphql": "^16.11.0",
    "liquidjs": "^10.30.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0"
  }
}
