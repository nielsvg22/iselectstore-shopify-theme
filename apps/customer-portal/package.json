{
  "name": "iselectstore-customer-portal",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "dev": "shopify app dev",
    "build": "shopify app build",
    "bundle": "esbuild extensions/portal/src/Portal.tsx --bundle --format=esm --jsx=automatic --jsx-import-source=preact --outfile=dist/portal.js --minify",
    "bundle:entry": "esbuild extensions/portal-entry/src/Entry.tsx --bundle --format=esm --jsx=automatic --jsx-import-source=preact --outfile=dist/entry.js --minify",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run bundle && npm run bundle:entry && node scripts/browser-smoke.mjs",
    "deploy": "shopify app deploy"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@shopify/ui-extensions": "2026.7.4",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@shopify/cli": "^3.89.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "graphql": "^16.11.0",
    "liquidjs": "^10.30.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0"
  }
}
