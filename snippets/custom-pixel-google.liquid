{% comment %}
  Custom pixel voor het video-retargeting-event, via Shopify Customer Events.
  Kopieer de inhoud van dit snippet naar:
  Shopify Admin → Instellingen → Customer Events → Custom pixel toevoegen

  Stuurt BEWUST alleen het 'video_engaged'-event door — niet page_view,
  view_item, add_to_cart, begin_checkout of purchase. Die standaard-events
  worden al gedekt door Shopify's eigen "Google & YouTube"-kanaal-app
  (Server + Web toegang, al actief in Customer Events). Nog een keer
  hetzelfde via gtag() zou die events dubbel tellen in Analytics/Ads.
{% endcomment %}

{% if settings.google_analytics_id != blank or settings.google_ads_id != blank %}
<script>
  (function () {
    var GA_ID = '{{ settings.google_analytics_id }}';
    var AW_ID = '{{ settings.google_ads_id }}';

    function loadGtag() {
      if (window.gtag) return;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + (GA_ID || AW_ID);
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      gtag('js', new Date());
      if (GA_ID) gtag('config', GA_ID, { send_page_view: false });
      if (AW_ID) gtag('config', AW_ID, { send_page_view: false });
    }

    function consentAccepted() {
      return window.Shopify && window.Shopify.customerPrivacy && window.Shopify.customerPrivacy.userCanBeTracked();
    }

    window.Shopify = window.Shopify || {};
    window.Shopify.customerEvents = window.Shopify.customerEvents || [];
    window.Shopify.customerEvents.push(function (event) {
      if (!consentAccepted()) return;
      if (event.name !== 'video_engaged') return;
      if (!window.gtag) loadGtag();

      var data = event.data || {};
      gtag('event', 'video_progress', { video_title: data.video, video_percent: data.percent });
    });
  })();
</script>
{% endif %}
