{% comment %}
  Voorraadmelding formulier — verschijnt boven de "Uitverkocht"-knop.
  Verstuurt e-mail + product-id naar de backend; de backend lost de
  productidentiteit zelf op zodat meldingen altijd kloppen.
{% endcomment %}

{% if current_variant.available == false %}
  {% assign wa_backend = settings.stock_notify_backend_url | default: 'https://iselectstore-marktplaats-app.vercel.app' %}
  <div class="invNotify" data-invnotify>
    <h3 class="invNotify__title">{{ 'inventory_notify.title' | t }}</h3>
    <p class="invNotify__text">{{ 'inventory_notify.description' | t }}</p>

    <form class="invNotify__form" data-invnotify-form>
      <input type="hidden" name="productId" value="{{ product.id }}">
      <input
        type="email"
        name="email"
        class="shopSearchInput"
        placeholder="{{ 'inventory_notify.email_placeholder' | t }}"
        required
        autocomplete="email"
        aria-label="{{ 'inventory_notify.email_aria' | t }}"
      >
      <button type="submit" class="btn primary" data-invnotify-submit>{{ 'inventory_notify.submit' | t }}</button>
    </form>

    <p class="invNotify__msg" data-invnotify-msg role="status" hidden></p>
  </div>

  <style>
    .invNotify {
      background: var(--soft);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 22px;
      margin: 0 0 16px;
    }
    .invNotify__title {
      font-size: 17px;
      font-weight: 700;
      color: var(--navy);
      margin: 0 0 8px;
      line-height: 1.35;
    }
    .invNotify__text {
      font-size: 14px;
      color: var(--muted);
      margin: 0 0 16px;
      line-height: 1.5;
    }
    .invNotify__form {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .invNotify__form .shopSearchInput {
      flex: 1;
      min-width: 200px;
      background: #fff;
      color: var(--ink);
      border: 1.5px solid var(--coral);
    }
    .invNotify__form .shopSearchInput::placeholder {
      color: var(--muted);
      opacity: 1;
    }
    .invNotify__form .shopSearchInput:focus {
      border-color: var(--coral-ink);
      box-shadow: 0 0 0 3px rgba(249, 133, 139, .22);
    }
    .invNotify__form .btn.primary {
      color: var(--navy);
    }
    .invNotify__form .btn {
      white-space: nowrap;
    }
    .invNotify__form .btn[disabled] {
      opacity: .6;
      pointer-events: none;
    }
    .invNotify__msg {
      margin: 14px 0 0;
      font-size: 14px;
      font-weight: 600;
      color: var(--navy);
      line-height: 1.45;
    }
    .invNotify__msg.is-error {
      color: #dc2626;
    }
    @media (max-width: 640px) {
      .invNotify__form { flex-direction: column; }
      .invNotify__form .btn { width: 100%; }
    }
  </style>

  <script>
    (function () {
      var root = document.querySelector('[data-invnotify]');
      if (!root) return;
      var form = root.querySelector('[data-invnotify-form]');
      var message = root.querySelector('[data-invnotify-msg]');
      var button = root.querySelector('[data-invnotify-submit]');
      var appUrl = {{ wa_backend | json }};
      var successText = {{ 'inventory_notify.success' | t | json }};
      var genericError = {{ 'inventory_notify.errors.generic' | t | json }};

      // themeStrings staat pas onderaan de pagina; daarom pas bij het uitlezen.
      function codeMessage(code) {
        var strings = (window.themeStrings && window.themeStrings.inventoryErrors) || {};
        return (code && strings[code]) || null;
      }

      if (!form || !message || !button) return;

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        button.disabled = true;
        message.hidden = true;
        message.classList.remove('is-error');

        fetch(appUrl.replace(/\/$/, '') + '/api/inventory/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: form.email.value,
            productId: form.productId.value
          })
        })
          .then(function (r) {
            return r.json().catch(function () { return {}; }).then(function (data) {
              if (!r.ok || data.ok !== true) {
                throw new Error(codeMessage(data.code) || data.error || data.message || genericError);
              }
              return data;
            });
          })
          .then(function (data) {
            message.hidden = false;
            message.textContent = successText;
            form.reset();
          })
          .catch(function (err) {
            message.hidden = false;
            message.classList.add('is-error');
            message.textContent = (err && err.message) || genericError;
          })
          .then(function () {
            button.disabled = false;
          });
      });
    })();
  </script>
{% endif %}
