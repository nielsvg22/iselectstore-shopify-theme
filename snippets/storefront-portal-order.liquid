<article class="sp-order"><div class="sp-order-head"><div><p class="sp-eyebrow">{{ portal_order.created_at | date: '%d-%m-%Y' }}</p><h3>Bestelling {{ portal_order.name | escape }}</h3></div><span class="sp-badge">{% if portal_order.cancelled %}Geannuleerd{% else %}{% case portal_order.fulfillment_status %}{% when 'fulfilled' %}Verzonden{% when 'partial' %}Deels verzonden{% when 'restocked' %}Terug op voorraad{% else %}Nog niet volledig verzonden{% endcase %}{% endif %}</span></div>
  <div class="sp-order-preview">{% for item in portal_order.line_items limit: 2 %}<div class="sp-product"><span class="sp-product-image">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,180', alt: item.title }}{% else %}{% render 'portal-icon', icon: 'box' %}{% endif %}</span><div><strong>{{ item.product.title | default: item.title | escape }}</strong><small>{% if item.variant.title != blank and item.variant.title != 'Default Title' %}{{ item.variant.title | escape }} · {% endif %}Aantal {{ item.quantity }}</small></div></div>{% endfor %}</div>
  {% if portal_order.line_items.size > 2 %}<p class="sp-muted">+ {{ portal_order.line_items.size | minus: 2 }} andere producten</p>{% endif %}
  <div class="sp-order-foot"><div><strong>{{ portal_order.total_price | money_with_currency }}</strong><small>{% case portal_order.financial_status %}{% when 'paid' %}Betaald{% when 'pending' %}Betaling in behandeling{% when 'authorized' %}Betaling gereserveerd{% when 'partially_paid' %}Gedeeltelijk betaald{% when 'partially_refunded' %}Gedeeltelijk terugbetaald{% when 'refunded' %}Terugbetaald{% when 'voided' %}Betaling vervallen{% else %}Bekijk betaalstatus{% endcase %}</small></div><a class="sp-link" href="{{ portal_order.customer_order_url | default: portal_order.customer_url }}">Volledige bestelling {% render 'portal-icon', icon: 'arrow' %}</a></div>
  {% unless compact %}<details class="sp-order-details"><summary class="sp-link">Producten, bezorging & ondersteuning</summary><div class="sp-order-preview">{% for item in portal_order.line_items %}<div class="sp-product"><div><strong>{{ item.title | escape }}</strong><small>Aantal {{ item.quantity }} · {{ item.final_line_price | money_with_currency }}</small>{% assign portal_tracking_scheme = item.fulfillment.tracking_url | slice: 0, 8 %}{% if portal_tracking_scheme == 'https://' %}<a class="sp-link" href="{{ item.fulfillment.tracking_url | escape }}">Volg je pakket{% if item.fulfillment.tracking_company %} · {{ item.fulfillment.tracking_company | escape }}{% endif %} {% render 'portal-icon', icon: 'arrow' %}</a>{% endif %}</div></div>{% endfor %}</div><p class="sp-muted">Open de volledige bestelling voor de actuele bestelstatus en beschikbare retouropties.</p><a class="sp-link" href="mailto:{{ shop.email | escape }}?subject={{ 'Vraag over bestelling ' | append: portal_order.name | url_encode }}">Hulp bij deze bestelling {% render 'portal-icon', icon: 'arrow' %}</a></details>{% endunless %}
</article>
