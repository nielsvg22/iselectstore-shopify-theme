{% comment %}
  Renders the iSelectStore brand mark (coral asterisk). Usage:
  {% render 'icon-mark', size: 20 %}
  {% render 'icon-mark', class: 'stMark' %} (size controlled by that CSS class instead)
{% endcomment %}
{% assign mark_class = class | default: 'mark' %}
{% assign mark_size = size | default: 24 %}
<img
  class="{{ mark_class }}"
  src="{{ 'brand-mark-coral.svg' | asset_url }}"
  width="{{ mark_size }}" height="{{ mark_size }}"
  {% if size %}style="width:{{ size }}px;height:{{ size }}px"{% endif %}
  alt=""
  loading="lazy"
>
