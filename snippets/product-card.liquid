{% comment %} Verwacht: product, optioneel index (positie in de grid, voor staggered reveal) {% endcomment %}
{% comment %}Sold exports retain their original image ID in the filename. Prefer that exact original, then another clean photo of the same item.{% endcomment %}
{% liquid
  assign card_image = product.featured_image
  assign card_filename = card_image.src | split: '/' | last | split: '?' | first | downcase
  if card_filename contains 'verkocht-'
    assign source_image_id = card_filename | remove_first: 'verkocht-' | split: '.' | first | split: '_' | first
    assign clean_candidate = nil
    for item_image in product.images
      assign item_filename = item_image.src | split: '/' | last | split: '?' | first | downcase
      unless item_filename contains 'verkocht-'
        if clean_candidate == nil
          assign clean_candidate = item_image
        endif
        assign item_image_id = item_image.id | append: ''
        if item_image_id == source_image_id
          assign clean_candidate = item_image
          break
        endif
      endunless
    endfor
    if clean_candidate != nil
      assign card_image = clean_candidate
    endif
  endif
  assign card_filename = card_image.src | split: '/' | last | split: '?' | first | downcase
%}
{% assign stagger_index = index | default: 0 | at_most: 8 %}
{% assign stagger_delay = stagger_index | times: 0.06 %}
<article class="card reveal{% if collection_card %} collectionCard{% endif %}" data-product-id="{{ product.id }}" data-available="{{ product.available }}" data-category="{{ product.type | escape }}" style="transition-delay:{{ stagger_delay }}s">
  <a class="productCardVisual" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if card_image %}
      {% if collection_card %}
        <img src="{{ card_image | image_url: width: 600 }}" srcset="{{ card_image | image_url: width: 300 }} 300w, {{ card_image | image_url: width: 450 }} 450w, {{ card_image | image_url: width: 600 }} 600w" sizes="(min-width:1600px) 280px, (min-width:1200px) 300px, (min-width:901px) 330px, 50vw" width="600" height="600" alt="{{ card_image.alt | default: product.title | escape }}" {% if index < 4 %}loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
      {% else %}
        <img src="{{ card_image | image_url: width: 600 }}" width="600" height="600" alt="{{ card_image.alt | default: product.title | escape }}" loading="lazy">
      {% endif %}
    {% endif %}
    {% unless product.available %}
      <span class="productSoldRibbon">VERKOCHT</span>
    {% endunless %}
  </a>
  {% if product.available %}
    {% assign badge_label = product.metafields.custom.badge_text | default: product.metafields.custom.condition %}
    {% if badge_label %}<span class="badge">{{ badge_label }}</span>{% endif %}
  {% endif %}
  <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
  <div class="meta">
    {%- if product.metafields.custom.condition -%}{{ product.metafields.custom.condition }}{%- endif -%}
    {%- if product.metafields.custom.battery_percentage %} · {{ product.metafields.custom.battery_percentage }}{{ 'product_card.meta_battery_suffix' | t }}{% endif -%}
    {%- if product.metafields.custom.warranty_months %} · {{ 'product_card.meta_warranty_prefix' | t }} {{ product.metafields.custom.warranty_months }} {{ 'product_card.warranty_suffix' | t }}{% endif -%}
  </div>
  {% if collection_card %}
    {% assign card_storage = product.metafields.custom.storage_gb.value | default: product.metafields.custom.storage_gb %}
    <div class="collectionSpecs">
      {% if card_storage != blank %}<span>{{ card_storage | escape }} GB</span>{% endif %}
      {% for option in product.options_with_values %}
        {% assign option_name = option.name | downcase %}
        {% if option_name == 'kleur' or option_name == 'color' or option_name == 'colour' %}<span>{{ option.values | join: ' / ' | escape }}</span>{% endif %}
        {% if card_storage == blank %}{% if option_name == 'opslag' or option_name == 'opslagcapaciteit' or option_name == 'storage' %}<span>{{ option.values | join: ' / ' | escape }}</span>{% endif %}{% endif %}
      {% endfor %}
    </div>
    <p class="collectionStock{% unless product.available %} collectionStock--sold{% endunless %}"><span aria-hidden="true"></span>{% if product.available %}Op voorraad{% else %}Uitverkocht{% endif %}</p>
  {% endif %}
  <div class="price">
    <b>{{ product.price | money }}</b>
    {% if product.compare_at_price > product.price %}<span class="old">{{ product.compare_at_price | money }}</span>{% endif %}
  </div>
  <a class="add" href="{{ product.url }}" style="text-align:center">
    {{ 'product_card.cta' | t }}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
  </a>
</article>
